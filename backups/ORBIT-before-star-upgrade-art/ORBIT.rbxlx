      <Item class="ModuleScript" referent="RBXaf51064ee8c94aaca165425220066d0e">
        <Properties>
          <string name="Name">AccountMonetization</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit")
local Rules=require(Shared.MonetizationRules)
local U=require(Shared.StarUtil)
local Http=game:GetService("HttpService")
local M={}
local function updateBytes(account)
    if account.Runtime then account.Runtime.ReceiptLedgerBytes=#Http:JSONEncode(account.ProcessedReceipts)end
end
function M.ApplyProduct(account,offer,purchaseId,now,maxCurrency)
    local target=account.ActiveSystemId
    local run=account.Systems[target]
    local projected={Currency=run.Currency,PaidBoostEndsAt=account.PaidBoostEndsAt,ProcessedReceipts=account.ProcessedReceipts}
    local updated,receipt=Rules.ApplyProduct(projected,offer,purchaseId,now,maxCurrency)
    local result=U.Clone(account)
    if receipt.Status=="Granted" then
        if receipt.Effect.Type=="Currency" then
            receipt.Effect.SystemId=target;receipt.Effect.Generation=account.DiscoveryGeneration
            result.Systems[target].Currency=updated.Currency
        else result.PaidBoostEndsAt=updated.PaidBoostEndsAt end
        result.ProcessedReceipts[purchaseId]=U.Clone(receipt)
        updateBytes(result)
    end
    return result,receipt
end
function M.ReconcileReceipt(account,receipt)
    local result=U.Clone(account)
    if type(receipt)~="table" or receipt.Status~="Granted" or type(receipt.PurchaseId)~="string"
        or #receipt.PurchaseId==0 or #receipt.PurchaseId&gt;128 or type(receipt.Effect)~="table" then return result end
    if result.ProcessedReceipts[receipt.PurchaseId]then return result end
    local copy=U.Clone(receipt);local e=copy.Effect
    if e.Type=="Currency" then
        e.SystemId=e.SystemId or "Sun";e.Generation=e.Generation or 0
        if not result.UnlockedSystems[e.SystemId] or not U.Finite(e.Amount) or e.Amount&lt;=0 or e.Amount&gt;1e18
            or not U.Finite(e.Generation) or e.Generation%1~=0 or e.Generation&lt;0 or e.Generation&gt;result.DiscoveryGeneration then return result end
        if e.Generation==result.DiscoveryGeneration then
            local run=result.Systems[e.SystemId]
            if run.Currency+e.Amount&gt;1e18 then return result end
            run.Currency+=e.Amount
        end
    elseif e.Type=="PaidBoost" and U.Finite(e.EndsAt) and e.EndsAt&gt;0 then
        result.PaidBoostEndsAt=math.max(result.PaidBoostEndsAt,e.EndsAt)
    else return result end
    result.ProcessedReceipts[copy.PurchaseId]=copy;updateBytes(result)
    return result
end
return M
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX434f9c1a02f4491f8277d381135a2d6d">
        <Properties>
          <string name="Name">AccountProfile</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit")
local Stars=require(Shared.StarSystemCatalog)
local Themes=require(Shared.SystemThemeFactory)
local Upgrades=require(Shared.UpgradeCatalog)
local Progression=require(Shared.ProgressionCatalog)
local Offers=require(Shared.MonetizationCatalog)
local Stellar=require(script.Parent.StellarProgression)
local U=require(Shared.StarUtil)
local Engine=require(script.Parent.Economy)
local Http=game:GetService("HttpService")
local A={}
local engines={}
local localFields={"Currency","LifetimeCurrency","RunEarned","TotalClicks","LifetimePurchases","TotalExpeditions","Prestiges","Stars","CurrentZone","Upgrades","Research","Permanent","ClaimedAchievements","UnlockedZones","Daily","Expedition","LastSeen","PendingOfflineDoubleProductionBonus"}
local retained={"LifetimeCurrency","TotalClicks","LifetimePurchases","TotalExpeditions","ClaimedAchievements","Daily"}
local rootFields={"Version","Revision","LastOperationId","ActiveSystemId","DiscoveryGeneration","UnlockedSystems","StellarLinks","AutoBuyOwnership","OwnedPasses","EquippedCosmetic","PaidBoostEndsAt","ProcessedReceipts","LastTransition"}
local function integer(v,max) return U.Finite(v) and v&gt;=0 and v%1==0 and v&lt;=(max or 9e15) end
function A.Economy(id)
    assert(Stars.Get(id),"Unknown star system")
    if not engines[id]then engines[id]=Engine.new(Themes.Get(id),Upgrades,Progression)end
    return engines[id]
end
function A.New(now)
    return {Version=3,Revision=0,ActiveSystemId="Sun",DiscoveryGeneration=0,
        UnlockedSystems={Sun=true},Systems={Sun=A.Economy("Sun"):New(now)},
        StellarLinks={},AutoBuyOwnership={Sun={Owned=false,PreferredEnabled=false}},
        OwnedPasses={},PaidBoostEndsAt=0,ProcessedReceipts={},Runtime={ReceiptLedgerBytes=2}}
end
function A.CaptureAutoBuy(account,id,explicitPreference)
    local run=account.Systems[id];local ownership=account.AutoBuyOwnership[id]
    if not ownership then ownership={Owned=false,PreferredEnabled=false};account.AutoBuyOwnership[id]=ownership end
    local bought=(run.Research.AutoBuy or 0)&gt;0
    if bought then
        local previouslyOwned=ownership.Owned
        ownership.Owned=true
        if type(explicitPreference)=="boolean" then ownership.PreferredEnabled=explicitPreference
        elseif not previouslyOwned then ownership.PreferredEnabled=run.AutoBuyEnabled==true end
    end
end
function A.Project(account,id,now)
    local d=assert(account.Systems[id],"System has not been discovered")
    local owner=account.AutoBuyOwnership[id] or {Owned=false,PreferredEnabled=false}
    d.Runtime.OwnedPasses=U.Clone(account.OwnedPasses)
    d.PaidBoostEndsAt=account.PaidBoostEndsAt
    d.EquippedCosmetic=account.EquippedCosmetic
    d.Runtime.StellarBonuses=Stellar.Incoming(account,id)
    d.Runtime.ReceiptLedgerBytes=account.Runtime and account.Runtime.ReceiptLedgerBytes or 2
    d.Research.AutoBuy=owner.Owned and 1 or 0
    d.AutoBuyEnabled=owner.Owned and owner.PreferredEnabled and A.Economy(id):AutoBuyUnlocked(d) or false
    return d
end
local function validateReceipts(account)
    assert(type(account.ProcessedReceipts)=="table","Receipt ledger missing")
    for id,r in pairs(account.ProcessedReceipts)do
        assert(type(id)=="string" and #id&gt;0 and #id&lt;=128 and type(r)=="table" and r.Status=="Granted" and r.PurchaseId==id,"Invalid receipt ledger")
        assert(r.ProductId==nil or (integer(r.ProductId) and r.ProductId&gt;0),"Invalid receipt product")
        local e=r.Effect;assert(type(e)=="table","Invalid receipt effect")
        if e.Type=="Currency" then
            assert(U.Finite(e.Amount) and e.Amount&gt;0 and e.Amount&lt;=1e18,"Invalid currency receipt")
            assert(account.UnlockedSystems[e.SystemId]==true and integer(e.Generation,account.DiscoveryGeneration),"Invalid receipt destination")
        else assert(e.Type=="PaidBoost" and U.Finite(e.EndsAt) and e.EndsAt&gt;0,"Invalid boost receipt")end
    end
end
local function validateLocal(saved,id)
    assert(type(saved)=="table","Missing system run")
    for _,key in ipairs({"Currency","LifetimeCurrency","RunEarned","Stars"})do
        assert(U.Finite(saved[key]) and saved[key]&gt;=0 and saved[key]&lt;=1e18,"Invalid local balance: "..key)
    end
    for _,key in ipairs({"TotalClicks","LifetimePurchases","TotalExpeditions","Prestiges"})do assert(integer(saved[key]),"Invalid local counter")end
    local zones={};for _,z in ipairs(Themes.Get(id).Zones)do zones[z.Id]=true end
    assert(type(saved.UnlockedZones)=="table" and type(saved.CurrentZone)=="string" and zones[saved.CurrentZone] and saved.UnlockedZones[saved.CurrentZone]==true,"Invalid local world")
    for key,value in pairs(saved.UnlockedZones)do assert(zones[key] and value==true,"Unknown local world")end
    assert(saved.UnlockedZones[Themes.Get(id).Zones[1].Id],"First world missing")
    local lists={Upgrades=Upgrades,Research=Progression.Research,Permanent=Progression.Permanent,ClaimedAchievements=Progression.Achievements}
    for key,list in pairs(lists)do
        assert(type(saved[key])=="table","Local progression table missing")
        local ids={};for _,def in ipairs(list)do ids[def.Id]=def end
        for name,value in pairs(saved[key])do
            assert(ids[name],"Unknown progression key")
            if key=="ClaimedAchievements" then assert(value==true,"Invalid achievement claim")
            else assert(integer(value,ids[name].Max or 100000),"Invalid upgrade level")end
        end
    end
    assert(type(saved.Daily)=="table" and type(saved.Daily.Claimed)=="table" and type(saved.Daily.Baseline)=="table","Invalid daily state")
    assert(integer(saved.Daily.Day),"Invalid daily day")
    local dailyIds={};for _,def in ipairs(Progression.Daily)do dailyIds[def.Id]=true end
    for key,value in pairs(saved.Daily.Claimed)do assert(dailyIds[key] and value==true,"Invalid daily claim")end
    local totals={Clicks=saved.TotalClicks,Purchases=saved.LifetimePurchases,Trips=saved.TotalExpeditions}
    for key,value in pairs(saved.Daily.Baseline)do assert(totals[key] and integer(value,totals[key]),"Invalid daily baseline")end
    for key in pairs(totals)do assert(saved.Daily.Baseline[key]~=nil,"Missing daily baseline")end
    assert(U.Finite(saved.LastSeen) and saved.LastSeen&gt;=0 and saved.LastSeen&lt;=1e18,"Invalid last-seen time")
    assert(U.Finite(saved.PendingOfflineDoubleProductionBonus) and saved.PendingOfflineDoubleProductionBonus&gt;=0 and saved.PendingOfflineDoubleProductionBonus&lt;=1e18,"Invalid pending offline Energy")
    if saved.Expedition then
        local found;for _,def in ipairs(Progression.Expeditions)do if saved.Expedition.Id==def.Id then found=def end end
        assert(found and U.Finite(saved.Expedition.EndsAt) and U.Finite(saved.Expedition.Reward) and saved.Expedition.Reward&gt;=0 and saved.Expedition.Reward&lt;=1e18,"Invalid expedition")
    end
end
function A.Normalize(saved,now)
    local ok,result=pcall(function()
        if saved==nil then return A.New(now)end
        assert(type(saved)=="table","Invalid saved profile")
        if saved.Version~=3 then
            assert(saved.Version==nil or saved.Version==1 or saved.Version==2,"Unsupported save version")
            local empty=true;for key in pairs(saved)do if key~="_Session" then empty=false end end
            if empty then return A.New(now)end
            assert(saved.Version==1 or saved.Version==2 or saved.Currency~=nil or saved.Upgrades~=nil,"Unrecognized legacy profile")
            local a=A.New(now);local d=A.Economy("Sun"):Normalize(saved,now)
            a.Systems.Sun=d;a.OwnedPasses=U.Clone(d.Runtime.OwnedPasses)
            a.PaidBoostEndsAt=d.PaidBoostEndsAt;a.EquippedCosmetic=d.EquippedCosmetic
            a.ProcessedReceipts=U.Clone(d.ProcessedReceipts)
            for _,receipt in pairs(a.ProcessedReceipts)do if receipt.Effect.Type=="Currency" then receipt.Effect.SystemId="Sun";receipt.Effect.Generation=0 end end
            A.CaptureAutoBuy(a,"Sun")
            a.Runtime.ReceiptLedgerBytes=#Http:JSONEncode(a.ProcessedReceipts)
            A.Project(a,"Sun",now);return a
        end
        assert(integer(saved.Revision) and integer(saved.DiscoveryGeneration,3),"Invalid account revision")
        assert(type(saved.Systems)=="table" and type(saved.UnlockedSystems)=="table" and saved.UnlockedSystems.Sun==true,"Account systems missing")
        assert(type(saved.AutoBuyOwnership)=="table" and type(saved.StellarLinks)=="table" and type(saved.OwnedPasses)=="table","Account metadata missing")
        assert(Stars.Get(saved.ActiveSystemId) and saved.UnlockedSystems[saved.ActiveSystemId]==true,"Invalid active system")
        local a=U.Clone(saved);a.Systems={};local count=0;local gap=false
        for _,id in ipairs(Stars.Order)do
            if saved.UnlockedSystems[id]==true then
                assert(not gap,"Nonsequential discovery")
                validateLocal(saved.Systems[id],id);a.Systems[id]=A.Economy(id):Normalize(saved.Systems[id],now);count+=1
                local owner=saved.AutoBuyOwnership[id]
                assert(type(owner)=="table" and type(owner.Owned)=="boolean" and type(owner.PreferredEnabled)=="boolean","Auto Buy ownership missing")
            else gap=true end
        end
        assert(count==a.DiscoveryGeneration+1,"Discovery generation mismatch")
        for id,value in pairs(saved.UnlockedSystems)do assert(Stars.Get(id) and value==true,"Unknown discovered system")end
        for id in pairs(saved.Systems)do assert(saved.UnlockedSystems[id]==true,"Undiscovered system save")end
        for id in pairs(saved.AutoBuyOwnership)do assert(saved.UnlockedSystems[id]==true,"Unknown Auto Buy ownership")end
        for source,targets in pairs(a.StellarLinks)do
            assert(a.UnlockedSystems[source] and type(targets)=="table","Invalid stellar source")
            for target,link in pairs(targets)do
                assert(a.UnlockedSystems[target] and Stars.AreAdjacent(source,target) and type(link)=="table","Invalid stellar target")
                for section,levels in pairs(link)do
                    local catalog=Shared.StellarUpgradeCatalog
                    local defs=require(catalog)
                    assert((section=="Research" or section=="Ascension") and type(levels)=="table","Invalid stellar section")
                    for name,value in pairs(levels)do local def=defs.Get(section,name);assert(def and integer(value,def.Max),"Invalid stellar level")end
                end
            end
        end
        for key,value in pairs(a.OwnedPasses)do assert(Offers.Passes[key] and type(value)=="boolean","Invalid ownership cache")end
        assert(U.Finite(a.PaidBoostEndsAt) and a.PaidBoostEndsAt&gt;=0 and a.PaidBoostEndsAt&lt;=1e18,"Invalid paid boost")
        assert(a.EquippedCosmetic==nil or Offers.Cosmetics[a.EquippedCosmetic],"Invalid cosmetic")
        validateReceipts(a)
        a.Runtime={ReceiptLedgerBytes=#Http:JSONEncode(a.ProcessedReceipts)}
        for id in pairs(a.UnlockedSystems)do A.Project(a,id,now)end
        return a
    end)
    if not ok then return nil,tostring(result)end
    return result
end
function A.Serialize(account,now)
    local result={};for _,key in ipairs(rootFields)do result[key]=U.Clone(account[key])end
    result.Systems={}
    for id,run in pairs(account.Systems)do
        local encoded=A.Economy(id):Serialize(run,now);local localRun={}
        for _,key in ipairs(localFields)do localRun[key]=U.Clone(encoded[key])end
        if id~=account.ActiveSystemId then localRun.LastSeen=run.LastSeen end
        result.Systems[id]=localRun
    end
    return result
end
function A.Eligible(account,target)
    local previous=Stars.Previous(target)
    return previous~=nil and account.UnlockedSystems[target]~=true and account.UnlockedSystems[previous]==true
        and A.Economy(previous):WorldCount(account.Systems[previous])==13
end
function A.ProposeTravel(account,target,now)
    if not Stars.Get(target) or account.UnlockedSystems[target]~=true or target==account.ActiveSystemId then return nil,"Choose another discovered star."end
    local a=U.Clone(account);local source=a.ActiveSystemId
    a.Systems[source].LastSeen=now;a.Systems[source].Runtime=A.Economy(source):New(now).Runtime
    a.ActiveSystemId=target;a.Systems[target].LastSeen=now;a.Systems[target].Runtime=A.Economy(target):New(now).Runtime
    if a.Systems[target].Daily.Day~=math.floor(now/86400)then A.Economy(target):ResetDaily(a.Systems[target],now)end
    A.Project(a,target,now);return a
end
function A.ProposeDiscovery(account,target,now)
    if not A.Eligible(account,target)then return nil,"Own all 13 planets around the preceding star first."end
    local a=U.Clone(account)
    for id,run in pairs(a.Systems)do
        A.CaptureAutoBuy(a,id)
        local fresh=A.Economy(id):New(now)
        for _,key in ipairs(retained)do fresh[key]=U.Clone(run[key])end
        if fresh.Daily.Day~=math.floor(now/86400)then A.Economy(id):ResetDaily(fresh,now)end
        a.Systems[id]=fresh
    end
    a.UnlockedSystems[target]=true;a.Systems[target]=A.Economy(target):New(now)
    a.AutoBuyOwnership[target]={Owned=false,PreferredEnabled=false}
    a.ActiveSystemId=target;a.DiscoveryGeneration+=1
    local previous=Stars.Previous(target)
    for _,edge in ipairs({{previous,target},{target,previous}})do
        a.StellarLinks[edge[1]]=a.StellarLinks[edge[1]] or {}
        a.StellarLinks[edge[1]][edge[2]]=a.StellarLinks[edge[1]][edge[2]] or {Research={},Ascension={}}
    end
    for id in pairs(a.UnlockedSystems)do A.Project(a,id,now)end
    return a
end
function A.Snapshot(account,now,saveMode,writable)
    local id=account.ActiveSystemId;local run=A.Project(account,id,now)
    local s=A.Economy(id):Snapshot(run,now,saveMode,writable)
    s.ActiveSystemId=id;s.SystemName=Stars.Get(id).Name;s.DiscoveryGeneration=account.DiscoveryGeneration
    s.AccountRevision=account.Revision;s.StarSystems={};s.StellarUpgrades={Research={},Ascension={}}
    s.IncomingStellar=U.Clone(run.Runtime.StellarBonuses)
    for _,target in ipairs(Stars.Order)do
        local known=account.UnlockedSystems[target]==true
        table.insert(s.StarSystems,{Id=target,Name=Stars.Get(target).Name,Worlds=known and A.Economy(target):WorldCount(account.Systems[target]) or 0,
            Status=target==id and "Current" or known and "Travel" or A.Eligible(account,target) and "Discover" or "Locked",Previous=Stars.Previous(target)})
    end
    local definitions=require(Shared.StellarUpgradeCatalog)
    for _,target in ipairs(Stars.Order)do if Stars.AreAdjacent(id,target)then
        local link=account.StellarLinks[id] and account.StellarLinks[id][target]
        for _,section in ipairs({"Research","Ascension"})do for _,def in ipairs(definitions[section])do
            local current=link and link[section] and link[section][def.Id] or 0
            local cost=Stellar.Cost(section,def.Id,current)
            table.insert(s.StellarUpgrades[section],{TargetId=target,TargetName=Stars.Get(target).Name,Id=def.Id,Name=def.Name,Level=current,Max=def.Max,
                Amount=def.Amount,Effect=def.Effect,Cost=cost or 0,Wallet=def.Wallet,Locked=account.UnlockedSystems[target]~=true,
                CanBuy=writable==true and saveMode=="Cloud" and account.UnlockedSystems[target]==true and cost~=nil and run[def.Wallet]&gt;=cost})
        end end
    end end
    s.AutoBuyOwned=account.AutoBuyOwnership[id].Owned
    s.AutoBuyPreferredEnabled=account.AutoBuyOwnership[id].PreferredEnabled
    return s
end
return A
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX120c2e18c975446b9e6777dd189ae3a8">
        <Properties>
          <string name="Name">AccountStore</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit")
local U=require(Shared.StarUtil)
local Http=game:GetService("HttpService")
local Store={MaxCharacters=3800000}
local function validArguments(store,key,session,revision,op,now,leaseSeconds)
    return store and type(store.UpdateAsync)=="function" and type(key)=="string" and #key&gt;0
        and type(session)=="string" and #session&gt;0 and U.Finite(revision) and revision&gt;=0 and revision&lt;=9e15 and revision%1==0
        and type(op)=="string" and #op&gt;0 and #op&lt;=160 and U.Finite(now) and U.Finite(leaseSeconds) and leaseSeconds&gt;0
end
local function owns(old,session,now)
    return type(old)=="table" and type(old._Session)=="table" and old._Session.Id==session
        and U.Finite(old._Session.ExpiresAt) and old._Session.ExpiresAt&gt;now
        and (old.Version==nil or old.Version==1 or old.Version==2 or old.Version==3)
end
local function payload(snapshot,base,marker,session,now,seconds)
    if type(snapshot)~="table" or snapshot.Version~=3 then return nil end
    local copy=U.Clone(snapshot)
    copy.Revision=base+1;copy.LastOperationId=marker
    copy._Session={Id=session,ExpiresAt=snapshot._ReleaseSession==true and 0 or now+seconds}
    copy._ReleaseSession=nil
    local ok,text=pcall(function()return Http:JSONEncode(copy)end)
    if not ok or #text&gt;Store.MaxCharacters then return nil end
    return copy
end
function Store.Commit(store,key,session,base,proposed,operationId,now,seconds)
    if not validArguments(store,key,session,base,operationId,now,seconds) then return "Conflict"end
    local nextValue=payload(proposed,base,operationId,session,now,seconds)
    if not nextValue then return "Capacity"end
    local status="Conflict"
    local ok,saved=pcall(function()
        return store:UpdateAsync(key,function(old)
            status="Conflict"
            if type(old)=="table" and type(old._Session)=="table" and old._Session.Id==session and old.LastOperationId==operationId then status="Committed";return old end
            if not owns(old,session,now)then return nil end
            if (old.Revision or 0)~=base then return nil end
            status="Committed";return U.Clone(nextValue)
        end)
    end)
    if not ok then return "Retry"end
    if status=="Committed" and type(saved)=="table" and saved.LastOperationId==operationId then return "Committed",saved end
    return status,saved
end
function Store.Resolve(store,key,session,base,operationId,rollback,now,seconds)
    if not validArguments(store,key,session,base,operationId,now,seconds)then return "Conflict"end
    local cancellation="cancel:"..operationId
    local cancelled=payload(rollback,base,cancellation,session,now,seconds)
    if not cancelled then return "Capacity"end
    local status="Conflict"
    local ok,saved=pcall(function()
        return store:UpdateAsync(key,function(old)
            status="Conflict"
            if type(old)=="table" and type(old._Session)=="table" and old._Session.Id==session then
                if old.LastOperationId==operationId then status="Committed";return old end
                if old.LastOperationId==cancellation then status="NotCommitted";return old end
            end
            if not owns(old,session,now)then return nil end
            if (old.Revision or 0)~=base then return nil end
            status="NotCommitted";return U.Clone(cancelled)
        end)
    end)
    if not ok then return "Retry"end
    if type(saved)=="table" then
        if status=="Committed" and saved.LastOperationId==operationId then return status,saved end
        if status=="NotCommitted" and saved.LastOperationId==cancellation then return status,saved end
    end
    return "Conflict"
end
return Store
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX2ea6e3ad051046e38dcf1396f5bbaf96">
        <Properties>
          <string name="Name">ClickerServer</string>
          <ProtectedString name="Source">-- Server-authoritative linked star accounts. One lease and receipt ledger per player.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local MarketplaceService=game:GetService("MarketplaceService")
local DataStoreService=game:GetService("DataStoreService")
local HttpService=game:GetService("HttpService")
local RunService=game:GetService("RunService")
local Kit=ReplicatedStorage:WaitForChild("ClickerKit")
local Config=require(Kit.ThemeConfig)
local Account=require(script.Parent.AccountProfile)
local Runtime=require(script.Parent.StarAccountRuntime)
local Offers=require(Kit.MonetizationCatalog)
local Rules=require(Kit.MonetizationRules)
local U=require(Kit.StarUtil)
local Remotes=Kit.Remotes
local Profiles,Loading,LastAction,LastSnapshot={},{},{},{}
local SessionId=game.JobId~="" and game.JobId or HttpService:GenerateGUID(false)
local LeaseSeconds=180
local Store
local ready,result=pcall(function()return DataStoreService:GetDataStore(Config.DataStoreName)end)
if ready then Store=result else warn("ORBIT: DataStore unavailable; Studio preview is temporary.")end
local function clock()return workspace:GetServerTimeNow()end
local function checkReconnect(player,r)
    if r.Unresolved and player.Parent then player:Kick("Your saving connection could not be verified. Please rejoin. Saved star systems have not been replaced.")end
end
local function sync(player)
    local r=Profiles[player];if not r or not player.Parent then return end
    local snapshot=r:Snapshot(clock())
    local stats=player:FindFirstChild("leaderstats")
    if stats then stats[Config.Currency.Name].Value=snapshot.Currency;stats.Ascensions.Value=snapshot.Prestiges end
    Remotes.StateUpdate:FireClient(player,snapshot)
end
local function feedback(player,gain)
    local r=Profiles[player];if not r then return end
    local item=Rules.ClickFeedback(gain)
    if item then item.ActiveSystemId=r.Account.ActiveSystemId;item.DiscoveryGeneration=r.Account.DiscoveryGeneration;item.AccountRevision=r.Account.Revision;Remotes.StateUpdate:FireClient(player,item)end
end
local function releaseLeaseOnly(player)
    if not Store then return end
    pcall(function()Store:UpdateAsync("User_"..player.UserId,function(old)
        if type(old)~="table" or type(old._Session)~="table" or old._Session.Id~=SessionId then return nil end
        local copy=U.Clone(old);copy._Session.ExpiresAt=0;return copy
    end)end)
end
local function load(player)
    if not Store then return nil,false end
    local now=os.time()
    local ok,saved=pcall(function()return Store:UpdateAsync("User_"..player.UserId,function(old)
        if old==nil then old={}end
        if type(old)~="table"then return nil end
        local lease=old._Session
        if type(lease)=="table" and lease.Id~=SessionId and U.Finite(lease.ExpiresAt) and lease.ExpiresAt&gt;now then return nil end
        local copy=U.Clone(old);copy._Session={Id=SessionId,ExpiresAt=now+LeaseSeconds};return copy
    end)end)
    if not ok or type(saved)~="table"then warn("ORBIT: could not acquire profile for "..player.Name);return nil,false end
    return saved,true
end
local function refreshOwnership(player,r,attempt)
    local token=r:OwnershipToken()
    local owned,unknown=Rules.ResolvePassOwnership(MarketplaceService,player.UserId,Offers.Passes)
    if Profiles[player]~=r or not player.Parent then return end
    r:ApplyOwnership(owned,token);sync(player)
    if unknown and (attempt or 0)&lt;2 then task.delay(30,function()if Profiles[player]==r then refreshOwnership(player,r,(attempt or 0)+1)end end)end
end
local function save(player,release)
    local r=Profiles[player];if not r then return end
    local started=os.clock()
    while r.Busy and not r.Unresolved and os.clock()-started&lt;20 do task.wait(.1)end
    local status=r:Save(release)
    if not release then
        if status=="Capacity"then Account.Economy(r.Account.ActiveSystemId):Notice(r.Account.Systems[r.Account.ActiveSystemId],"Saving is paused because this profile is near its storage limit.","Error")end
        checkReconnect(player,r)
    end
end
local function joined(player)
    if Profiles[player] or Loading[player]then return end
    Loading[player]=true
    local saved,writable=load(player)
    if not writable and not RunService:IsStudio()then
        Loading[player]=nil
        if player.Parent then player:Kick("Your saved progress could not be loaded. Please rejoin. Existing progress has not been replaced.")end
        return
    end
    local now=clock();local account,err=Account.Normalize(saved,now)
    if not account then
        releaseLeaseOnly(player);Loading[player]=nil;warn("ORBIT: refusing unsupported/corrupt profile: "..tostring(err))
        if player.Parent then player:Kick("Your saved profile needs attention and was not changed. Please contact the game owner.")end
        return
    end
    local owned,unknown=Rules.ResolvePassOwnership(MarketplaceService,player.UserId,Offers.Passes,"DoubleProduction")
    if not player.Parent then releaseLeaseOnly(player);Loading[player]=nil;return end
    local active=account.ActiveSystemId;local run=Account.Project(account,active,now)
    Account.Economy(active):InitializeSession(run,now,owned,writable,unknown)
    account.OwnedPasses=U.Clone(run.Runtime.OwnedPasses)
    local r=Runtime.new(account,{Store=Store,UserId=player.UserId,UserKey="User_"..player.UserId,SessionId=SessionId,
        LeaseSeconds=LeaseSeconds,GameClock=clock,LeaseClock=os.time,Writable=writable,SaveMode=writable and "Cloud" or "Temporary",
        TransitionsEnabled=Config.StarTransitionsEnabled~=false})
    if writable then
        local status=r:Save(false)
        if status=="Capacity"then releaseLeaseOnly(player);r.Writable=false;r.SaveMode="Temporary"end
    end
    if not player.Parent then r:Save(true);Loading[player]=nil;return end
    if r.Unresolved then Loading[player]=nil;checkReconnect(player,r);return end
    if not r.Writable and not RunService:IsStudio()then
        Loading[player]=nil;player:Kick("Your saved profile could not be safely updated. Please contact the game owner. Existing progress has not been replaced.");return
    end
    Profiles[player]=r;Loading[player]=nil
    local old=player:FindFirstChild("leaderstats");if old then old:Destroy()end
    local stats=Instance.new("Folder");stats.Name="leaderstats"
    for _,name in ipairs({Config.Currency.Name,"Ascensions"})do local n=Instance.new("NumberValue");n.Name=name;n.Parent=stats end
    stats.Parent=player
    sync(player);task.spawn(refreshOwnership,player,r,0)
end
local function action(player,kind,id,quantity)
    local r=Profiles[player];if not r or type(kind)~="string"then return end
    local now=clock()
    if kind~="CheckoutBusy" then
        LastAction[player]=LastAction[player] or {}
        local bucket=kind=="Click" and "Click" or "Other"
        if now-(LastAction[player][bucket] or 0)&lt;(kind=="Click" and Config.ClickCooldown or .12)then return end
        LastAction[player][bucket]=now
    end
    local oldSystem,oldGeneration=r.Account.ActiveSystemId,r.Account.DiscoveryGeneration
    local ok,message=r:Action(kind,id,quantity,now)
    if not ok and message and not r.Unresolved then Account.Economy(r.Account.ActiveSystemId):Notice(r.Account.Systems[r.Account.ActiveSystemId],message,"Error")end
    if ok and kind=="Click"then feedback(player,r.Account.Systems[r.Account.ActiveSystemId].Runtime.LastClickGain)end
    if oldSystem~=r.Account.ActiveSystemId or oldGeneration~=r.Account.DiscoveryGeneration then task.spawn(refreshOwnership,player,r,0)end
    sync(player);checkReconnect(player,r)
end
Remotes.RequestAction.OnServerEvent:Connect(action)
Remotes.RequestClick.OnServerEvent:Connect(function(p)action(p,"Click")end)
Remotes.RequestPurchase.OnServerEvent:Connect(function(p,id)action(p,"Buy",id,1)end)
Remotes.RequestZone.OnServerEvent:Connect(function(p,id)action(p,"Zone",id)end)
Remotes.RequestPrestige.OnServerEvent:Connect(function(p)action(p,"Rebirth")end)
Remotes.RequestSnapshot.OnServerEvent:Connect(function(p)
    local now=clock();if now-(LastSnapshot[p] or 0)&lt;.5 then return end
    LastSnapshot[p]=now;sync(p)
end)
local function processReceipt(info)
    local offer=Offers.ResolveProduct(info.ProductId)
    local player=Players:GetPlayerByUserId(info.PlayerId)
    local r=player and Profiles[player]
    if not offer or not r then return Enum.ProductPurchaseDecision.NotProcessedYet end
    local status=r:ProcessReceipt(offer,info.PurchaseId,clock())
    sync(player);checkReconnect(player,r)
    return (status=="Granted" or status=="Duplicate")and Enum.ProductPurchaseDecision.PurchaseGranted or Enum.ProductPurchaseDecision.NotProcessedYet
end
MarketplaceService.ProcessReceipt=processReceipt
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)
    local r=Profiles[player];if not r then return end
    r.CheckoutUntil=0
    if purchased then
        for key,offer in pairs(Offers.Passes)do if offer.Id==id then r:ConfirmPassPurchase(key);break end end
        task.spawn(refreshOwnership,player,r,0);task.spawn(save,player,false)
    end
    sync(player)
end)
Players.CharacterAutoLoads=false
for _,p in ipairs(Players:GetPlayers())do if p.Character then p.Character:Destroy()end end
Players.PlayerAdded:Connect(joined)
for _,p in ipairs(Players:GetPlayers())do task.spawn(joined,p)end
Players.PlayerRemoving:Connect(function(p)
    save(p,true);Profiles[p]=nil;Loading[p]=nil;LastAction[p]=nil;LastSnapshot[p]=nil
end)
task.spawn(function()
    local previous=clock();local lastSync=previous
    while task.wait(Rules.AutoTapInterval)do
        local now=clock();local dt=now-previous;previous=now
        for p,r in pairs(Profiles)do if p.Parent then
            for _,gain in ipairs(r:Tick(now,dt))do feedback(p,gain)end
        end end
        if now-lastSync&gt;=1 then lastSync=now;for p in pairs(Profiles)do sync(p)end end
    end
end)
task.spawn(function()while task.wait(Config.AutoSaveSeconds)do for p in pairs(Profiles)do task.spawn(save,p,false)end end end)
game:BindToClose(function()
    local pending=0
    for p in pairs(Profiles)do pending+=1;task.spawn(function()save(p,true);pending-=1 end)end
    local started=os.clock();while pending&gt;0 and os.clock()-started&lt;25 do task.wait(.1)end
end)

</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX44b8f456f35b43a89f222cd9b551596b">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source">-- Deterministic economy. All actions receive server time; clients never supply rewards.
local Economy = {}
Economy.__index = Economy
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local MonetizationCatalog = require(ReplicatedStorage:WaitForChild("ClickerKit"):WaitForChild("MonetizationCatalog"))
local MonetizationRules = require(ReplicatedStorage.ClickerKit:WaitForChild("MonetizationRules"))
local function number(v, fallback, max)
    if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
        return fallback or 0
    end
    return math.clamp(v, 0, max or 1e18)
end
local function finite(v)
    return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end
local function count(v, max)
    return math.floor(number(v, 0, max or 1000000))
end
local function clone(t)
    local r = {}
    for k, v in pairs(t or {}) do
        r[k] = type(v) == "table" and clone(v) or v
    end
    return r
end
local function find(list, id)
    for _, v in ipairs(list) do
        if v.Id == id then
            return v
        end
    end
    return nil
end
local function formatAmount(value)
    local digits = tostring(math.floor(value))
    local groups = {}
    while #digits &gt; 3 do
        table.insert(groups, 1, string.sub(digits, -3))
        digits = string.sub(digits, 1, -4)
    end
    table.insert(groups, 1, digits)
    return table.concat(groups, ",")
end
function Economy.new(config, catalog, progression)
    return setmetatable({ Config = config, Catalog = catalog, P = progression }, Economy)
end
function Economy:New(now)
    return {
        Currency = 0,
        LifetimeCurrency = 0,
        RunEarned = 0,
        TotalClicks = 0,
        LifetimePurchases = 0,
        TotalExpeditions = 0,
        Upgrades = {},
        Research = {},
        Permanent = {},
        ClaimedAchievements = {},
        UnlockedZones = { [self.Config.Zones[1].Id] = true },
        CurrentZone = self.Config.Zones[1].Id,
        Prestiges = 0,
        Stars = 0,
        Expedition = nil,
        LastSeen = now,
        PendingOfflineDoubleProductionBonus = 0,
        PaidBoostEndsAt = 0,
        ProcessedReceipts = {},
        EquippedCosmetic = nil,
        AutoBuyEnabled = false,
        Daily = { Day = math.floor(now / 86400), Baseline = { Clicks = 0, Purchases = 0, Trips = 0 }, Claimed = {} },
        Runtime = {
            Charge = 0,
            BurstEndsAt = 0,
            EventEndsAt = 0,
            EventNextAt = now + self.P.Collectible.FirstDelay,
            EventNonce = 0,
            OwnedPasses = {},
            AutoTapAccumulator = 0,
            AutoBuyAccumulator = 0,
            NoticeSerial = 0,
            Notice = "",
            NoticeKind = "",
            OfflineEarned = 0,
            OfflineSeconds = 0,
            ReceiptLedgerBytes = 2,
        },
    }
end
function Economy:Normalize(saved, now)
    local d = self:New(now)
    if type(saved) ~= "table" then
        return d
    end
    for _, k in ipairs({ "Currency", "LifetimeCurrency", "RunEarned", "Stars" }) do
        d[k] = number(saved[k], 0, self.Config.MaximumCurrency)
    end
    for _, k in ipairs({ "TotalClicks", "LifetimePurchases", "TotalExpeditions", "Prestiges" }) do
        d[k] = count(saved[k], 9e15)
    end
    for _, v in ipairs(self.Catalog) do
        d.Upgrades[v.Id] = count(type(saved.Upgrades) == "table" and saved.Upgrades[v.Id], 100000)
    end
    for _, kind in ipairs({ "Research", "Permanent" }) do
        for _, v in ipairs(self.P[kind]) do
            d[kind][v.Id] = count(type(saved[kind]) == "table" and saved[kind][v.Id], v.Max)
        end
    end
    for _, z in ipairs(self.Config.Zones) do
        if type(saved.UnlockedZones) == "table" and saved.UnlockedZones[z.Id] == true then
            d.UnlockedZones[z.Id] = true
        end
    end
    if type(saved.CurrentZone) == "string" and d.UnlockedZones[saved.CurrentZone] then
        d.CurrentZone = saved.CurrentZone
    end
    d.AutoBuyEnabled = saved.AutoBuyEnabled == true and self:AutoBuyUnlocked(d)
    for _, a in ipairs(self.P.Achievements) do
        if type(saved.ClaimedAchievements) == "table" and saved.ClaimedAchievements[a.Id] == true then
            d.ClaimedAchievements[a.Id] = true
        end
    end
    d.LastSeen = number(saved.LastSeen, now, now)
    d.PendingOfflineDoubleProductionBonus =
        number(saved.PendingOfflineDoubleProductionBonus, 0, self.Config.MaximumCurrency)
    if type(saved.OwnedPasses) == "table" then
        for key in pairs(MonetizationCatalog.Passes) do
            if type(saved.OwnedPasses[key]) == "boolean" then
                d.Runtime.OwnedPasses[key] = saved.OwnedPasses[key]
            end
        end
    end
    d.PaidBoostEndsAt = number(saved.PaidBoostEndsAt, 0, 1e18)
    d.EquippedCosmetic = type(saved.EquippedCosmetic) == "string"
            and MonetizationCatalog.Cosmetics[saved.EquippedCosmetic]
            and saved.EquippedCosmetic
        or nil
    if type(saved.ProcessedReceipts) == "table" then
        for purchaseId, receipt in pairs(saved.ProcessedReceipts) do
            local effect = type(receipt) == "table" and receipt.Effect
            local validEffect = type(effect) == "table"
                and (
                    (effect.Type == "Currency" and finite(effect.Amount) and effect.Amount &gt; 0)
                    or (effect.Type == "PaidBoost" and finite(effect.EndsAt) and effect.EndsAt &gt; 0)
                )
            if
                type(purchaseId) == "string"
                and #purchaseId &gt; 0
                and #purchaseId &lt;= 128
                and type(receipt) == "table"
                and receipt.Status == "Granted"
                and receipt.PurchaseId == purchaseId
                and validEffect
            then
                d.ProcessedReceipts[purchaseId] = clone(receipt)
            end
        end
    end
    d.Runtime.ReceiptLedgerBytes = #HttpService:JSONEncode(d.ProcessedReceipts)
    if type(saved.Expedition) == "table" then
        local def = find(self.P.Expeditions, saved.Expedition.Id)
        if def then
            d.Expedition = {
                Id = def.Id,
                EndsAt = number(saved.Expedition.EndsAt, now, now + def.Duration),
                Reward = number(saved.Expedition.Reward, 0, self.Config.MaximumCurrency),
            }
        end
    end
    local daily = saved.Daily
    if type(daily) == "table" and daily.Day == d.Daily.Day then
        if type(daily.Baseline) == "table" then
            for metric, total in pairs({
                Clicks = d.TotalClicks,
                Purchases = d.LifetimePurchases,
                Trips = d.TotalExpeditions,
            }) do
                d.Daily.Baseline[metric] = number(daily.Baseline[metric], total, total)
            end
        end
        for _, a in ipairs(self.P.Daily) do
            if type(daily.Claimed) == "table" and daily.Claimed[a.Id] == true then
                d.Daily.Claimed[a.Id] = true
            end
        end
    else
        self:ResetDaily(d, now)
    end
    return d
end
function Economy:ResetDaily(d, now)
    d.Daily = {
        Day = math.floor(now / 86400),
        Baseline = { Clicks = d.TotalClicks, Purchases = d.LifetimePurchases, Trips = d.TotalExpeditions },
        Claimed = {},
    }
end
function Economy:Serialize(d, now)
    local result = { Version = 2, LastSeen = now }
    for _, k in ipairs({
        "Currency",
        "LifetimeCurrency",
        "RunEarned",
        "TotalClicks",
        "LifetimePurchases",
        "TotalExpeditions",
        "Prestiges",
        "Stars",
        "CurrentZone",
    }) do
        result[k] = d[k]
    end
    for _, k in ipairs({ "Upgrades", "Research", "Permanent", "ClaimedAchievements", "UnlockedZones", "Daily" }) do
        result[k] = clone(d[k])
    end
    result.Expedition = d.Expedition and clone(d.Expedition) or nil
    result.AutoBuyEnabled = d.AutoBuyEnabled == true
    result.PaidBoostEndsAt = d.PaidBoostEndsAt or 0
    result.ProcessedReceipts = clone(d.ProcessedReceipts or {})
    result.EquippedCosmetic = d.EquippedCosmetic
    result.OwnedPasses = clone(d.Runtime.OwnedPasses or {})
    result.PendingOfflineDoubleProductionBonus = d.PendingOfflineDoubleProductionBonus or 0
    return result
end
function Economy:WorldCount(d)
    local n = 0
    for _, z in ipairs(self.Config.Zones) do
        if d.UnlockedZones[z.Id] then
            n += 1
        end
    end
    return n
end
function Economy:AutoBuyUnlocked(d)
    return (d.Research[self.P.AutoBuy.ResearchId] or 0) &gt;= 1
        and self:WorldCount(d) &gt;= self.P.AutoBuy.RequiredWorld
end
function Economy:Zone(d)
    return find(self.Config.Zones, d.CurrentZone) or self.Config.Zones[1]
end
function Economy:BurstMultiplier(d, now)
    return d.Runtime.BurstEndsAt &gt; now and self.P.Burst.Multiplier or 1
end
function Economy:PassMultiplier(d)
    local owned = d.Runtime and d.Runtime.OwnedPasses or {}
    return owned.DoubleProduction == true and 2 or 1
end
function Economy:PaidMultiplier(d, now)
    local multiplier = self:PassMultiplier(d)
    if (d.PaidBoostEndsAt or 0) &gt; now then
        multiplier *= 2
    end
    return multiplier
end
function Economy:BurstDuration(d)
    return self.P.Burst.Duration + (d.Research.Capacity or 0) * 0.75 + (d.Permanent.Power or 0)
end
function Economy:Mastery(d)
    return (1 + d.Prestiges * self.Config.Prestige.MultiplierPerPrestige) * (1 + (d.Permanent.Mastery or 0) * 0.1)
end
function Economy:StellarBonus(d, key)
    local b = d.Runtime and d.Runtime.StellarBonuses or {}
    local value = b[key]
    if key == "OfflineSeconds" then return math.clamp(number(value, 0), 0, 14400) end
    return math.clamp(number(value, 1), 1, 2)
end
function Economy:ClickCore(d)
    local base = self.Config.BaseClickPower
    for _, v in ipairs(self.Catalog) do
        base += v.ClickBonus * (d.Upgrades[v.Id] or 0)
    end
    return base
        * self:Zone(d).Multiplier
        * self:Mastery(d)
        * (1 + (d.Research.Focus or 0) * 0.2)
        * (1 + (d.Permanent.Touch or 0) * 0.25)
        * self:StellarBonus(d, "ClickMultiplier")
        * self:StellarBonus(d, "ProductionMultiplier")
end
function Economy:ClickPower(d, now)
    return self:ClickCore(d) * self:PaidMultiplier(d, now) * self:BurstMultiplier(d, now)
end
function Economy:PassiveCore(d)
    local rate = 0
    for _, v in ipairs(self.Catalog) do
        rate += v.PassivePerSecond * (d.Upgrades[v.Id] or 0)
    end
    return math.min(
        rate
            * self:Zone(d).Multiplier
            * self:Mastery(d)
            * (1 + (d.Research.Efficiency or 0) * 0.15)
            * (1 + (d.Permanent.Automation or 0) * 0.2)
            * self:StellarBonus(d, "PassiveMultiplier")
            * self:StellarBonus(d, "ProductionMultiplier"),
        self.Config.MaximumCurrency
    )
end
function Economy:Passive(d, now, unboosted)
    return math.min(
        self:PassiveCore(d) * self:PaidMultiplier(d, now) * (unboosted and 1 or self:BurstMultiplier(d, now)),
        self.Config.MaximumCurrency
    )
end
function Economy:GameplayEnergyReward(d, baseEnergy, clickCount, incomeSeconds, now)
    baseEnergy = number(baseEnergy, 0, self.Config.MaximumCurrency)
    clickCount = number(clickCount, 0, 1000000)
    incomeSeconds = number(incomeSeconds, 0, 1000000)
    local reward = baseEnergy + self:ClickPower(d, now) * clickCount + self:Passive(d, now, false) * incomeSeconds
    if reward ~= reward then
        return 0
    end
    return math.clamp(reward, 0, self.Config.MaximumCurrency)
end
function Economy:Cost(def, owned, d, producer)
    local price = (def.BaseCost or def.Cost) * (def.CostMultiplier or def.Growth) ^ math.min(owned, 1000)
    if producer then
        price *= 1 - (d.Research.Discount or 0) * 0.02
    end
    return math.max(1, math.floor(math.min(price, self.Config.MaximumCurrency) + 0.5))
end
function Economy:Add(d, amount)
    amount = number(amount, 0, self.Config.MaximumCurrency)
    local earned = math.min(amount, self.Config.MaximumCurrency - d.Currency)
    d.Currency += earned
    d.LifetimeCurrency = math.min(self.Config.MaximumCurrency, d.LifetimeCurrency + earned)
    d.RunEarned = math.min(self.Config.MaximumCurrency, d.RunEarned + earned)
    return earned
end
function Economy:ProductPurchaseNotice(receiptStatus, offer)
    if
        receiptStatus ~= "Granted"
        or type(offer) ~= "table"
        or type(offer.Name) ~= "string"
        or type(offer.Grant) ~= "table"
    then
        return nil
    end
    local grant = offer.Grant
    if grant.Type == "Currency" then
        local amount = number(grant.Amount, 0, self.Config.MaximumCurrency)
        if amount &lt;= 0 or amount % 1 ~= 0 then
            return nil
        end
        return offer.Name .. " purchased: +" .. formatAmount(amount) .. " Energy."
    elseif grant.Type == "PaidBoost" then
        local duration = number(grant.DurationSeconds, 0, self.Config.MaximumCurrency)
        if duration &lt;= 0 or duration % 60 ~= 0 then
            return nil
        end
        local minutes = duration / 60
        return offer.Name
            .. " active for "
            .. minutes
            .. " minute"
            .. (minutes == 1 and "" or "s")
            .. ". It stacks with natural x3 Overdrive."
    end
    return nil
end
function Economy:Notice(d, text, kind)
    d.Runtime.NoticeSerial += 1
    d.Runtime.Notice = text
    d.Runtime.NoticeKind = kind or "Reward"
end
function Economy:ResolvePendingOfflinePassBonus(d, ownsDoubleProduction)
    local pending = number(d.PendingOfflineDoubleProductionBonus, 0, self.Config.MaximumCurrency)
    local earned = 0
    local remaining = 0
    if ownsDoubleProduction then
        earned = self:Add(d, pending)
        remaining = math.max(0, pending - earned)
        d.Runtime.OfflineEarned = math.min(self.Config.MaximumCurrency, (d.Runtime.OfflineEarned or 0) + earned)
    end
    d.PendingOfflineDoubleProductionBonus = remaining
    return earned
end
function Economy:ApplyPassOwnership(d, ownedPasses, resolvePendingOffline)
    local merged = clone(d.Runtime.OwnedPasses or {})
    for key, value in pairs(ownedPasses or {}) do
        if type(value) == "boolean" then
            merged[key] = value
        end
    end
    d.Runtime.OwnedPasses = merged
    if resolvePendingOffline and type(ownedPasses) == "table" and type(ownedPasses.DoubleProduction) == "boolean" then
        self:ResolvePendingOfflinePassBonus(d, ownedPasses.DoubleProduction)
    end
    return merged
end
function Economy:ConfirmPassPurchase(d, passKey)
    if not MonetizationCatalog.Passes[passKey] then
        return false
    end
    d.Runtime.OwnedPasses[passKey] = true
    if passKey == "DoubleProduction" then
        self:ResolvePendingOfflinePassBonus(d, false)
    end
    return true
end
function Economy:InitializeSession(d, now, ownedPasses, applyOffline, ownershipUnknown)
    self:ApplyPassOwnership(d, ownedPasses, false)
    d.Runtime.AutoTapAccumulator = 0
    if applyOffline then
        self:Offline(d, now, ownershipUnknown == true)
    end
    if type(ownedPasses) == "table" and type(ownedPasses.DoubleProduction) == "boolean" then
        self:ResolvePendingOfflinePassBonus(d, ownedPasses.DoubleProduction)
    end
end
function Economy:Offline(d, now, ownershipUnknown)
    local hours = self.P.Offline.Hours + (d.Research.Storage or 0) * 0.5 + (d.Permanent.Clock or 0)
        + self:StellarBonus(d, "OfflineSeconds") / 3600
    local seconds = math.clamp(now - d.LastSeen, 0, math.min(hours, 24) * 3600)
    if seconds &gt;= 60 then
        local startAt = now - seconds
        local boosted = math.clamp((d.PaidBoostEndsAt or 0) - startAt, 0, seconds)
        local baseAmount = self:PassiveCore(d) * (seconds + boosted) * self.P.Offline.Efficiency
        local multiplier = self:PassMultiplier(d)
        local amount = baseAmount * multiplier
        local currencyBefore = d.Currency
        d.Runtime.OfflineEarned = self:Add(d, amount)
        d.Runtime.OfflineSeconds = seconds
        if ownershipUnknown and multiplier == 1 then
            local fullAmount = math.min(baseAmount * 2, math.max(0, self.Config.MaximumCurrency - currencyBefore))
            local pending = math.max(0, fullAmount - d.Runtime.OfflineEarned)
            d.PendingOfflineDoubleProductionBonus =
                math.min(self.Config.MaximumCurrency, (d.PendingOfflineDoubleProductionBonus or 0) + pending)
        end
    end
    d.LastSeen = now
end
function Economy:Metric(d, metric)
    if metric == "Clicks" then
        return d.TotalClicks
    elseif metric == "Earned" then
        return d.LifetimeCurrency
    elseif metric == "Trips" then
        return d.TotalExpeditions
    elseif metric == "Rebirths" then
        return d.Prestiges
    elseif metric == "Purchases" then
        return d.LifetimePurchases
    elseif metric == "Worlds" then
        return self:WorldCount(d)
    elseif metric == "Owned" then
        local n = 0
        for _, v in pairs(d.Upgrades) do
            n += v
        end
        return n
    end
    return 0
end
function Economy:RebirthCost(d)
    return math.min(
        self.Config.MaximumCurrency,
        self.Config.Prestige.BaseRequirement * self.Config.Prestige.RequirementMultiplier ^ math.min(d.Prestiges, 15)
    )
end
function Economy:RebirthGain(d)
    local maximum =
        math.max(1, math.floor(math.sqrt(self.Config.MaximumCurrency / self.Config.Prestige.BaseRequirement)))
    return math.clamp(math.floor(math.sqrt(d.RunEarned / self.Config.Prestige.BaseRequirement)), 1, maximum)
end
-- Shared purchase path keeps manual and automatic spending under identical gates.
function Economy:BuyProducer(d, def, limit)
    if self:WorldCount(d) &lt; (def.RequiredWorld or 1) then
        return 0
    end
    local bought = 0
    for _ = 1, limit do
        local owned = d.Upgrades[def.Id] or 0
        if owned &gt;= 100000 then
            break
        end
        local cost = self:Cost(def, owned, d, true)
        if d.Currency &lt; cost then
            break
        end
        d.Currency -= cost
        d.Upgrades[def.Id] = owned + 1
        bought += 1
        d.LifetimePurchases += 1
    end
    return bought
end
function Economy:Tick(d, now, dt)
    if d.Daily.Day ~= math.floor(now / 86400) then
        self:ResetDaily(d, now)
    end
    local elapsed = math.clamp(dt, 0, 5)
    local startAt = now - elapsed
    local boundaries = { startAt, now }
    for _, endsAt in ipairs({ d.Runtime.BurstEndsAt or 0, d.PaidBoostEndsAt or 0 }) do
        if endsAt &gt; startAt and endsAt &lt; now then
            table.insert(boundaries, endsAt)
        end
    end
    table.sort(boundaries)
    local amount = 0
    local base = self:PassiveCore(d)
    for i = 1, #boundaries - 1 do
        local fromAt, toAt = boundaries[i], boundaries[i + 1]
        local mid = (fromAt + toAt) * 0.5
        amount += base * self:PaidMultiplier(d, mid) * self:BurstMultiplier(d, mid) * (toAt - fromAt)
    end
    self:Add(d, amount)
    if d.Runtime.OwnedPasses.DoubleProduction == true and (d.PendingOfflineDoubleProductionBonus or 0) &gt; 0 then
        self:ResolvePendingOfflinePassBonus(d, true)
    end
    if d.Runtime.EventEndsAt &gt; 0 and now &gt;= d.Runtime.EventEndsAt then
        d.Runtime.EventEndsAt = 0
    end
    if now &gt;= d.Runtime.EventNextAt then
        d.Runtime.EventEndsAt = now + self.P.Collectible.Lifetime
        d.Runtime.EventNextAt = now + self.P.Collectible.Interval
        d.Runtime.EventNonce += 1
    end
    if d.AutoBuyEnabled and self:AutoBuyUnlocked(d) then
        d.Runtime.AutoBuyAccumulator = (d.Runtime.AutoBuyAccumulator or 0) + elapsed
        if d.Runtime.AutoBuyAccumulator &gt;= self.P.AutoBuy.Interval then
            d.Runtime.AutoBuyAccumulator %= self.P.AutoBuy.Interval
            -- Buy at most one level per research track each second, in catalog order.
            -- Never buy producers, permanent upgrades, or the Auto Buy unlock itself.
            for _, def in ipairs(self.P.Research) do
                if def.Id ~= self.P.AutoBuy.ResearchId then
                    local level = d.Research[def.Id] or 0
                    if level &lt; def.Max then
                        local cost = self:Cost(def, level, d)
                        if d.Currency &gt;= cost then
                            d.Currency -= cost
                            d.Research[def.Id] = level + 1
                        end
                    end
                end
            end
        end
    else
        d.Runtime.AutoBuyAccumulator = 0
    end
end
function Economy:Action(d, action, id, quantity, now)
    if type(action) ~= "string" then
        return false, "Unknown action."
    end
    if d.Daily.Day ~= math.floor(now / 86400) then
        self:ResetDaily(d, now)
    end
    if action == "EquipCosmetic" then
        if not MonetizationRules.CanEquipCosmetic(id, MonetizationCatalog.Cosmetics, d.Runtime.OwnedPasses or {}) then
            return false, "That cosmetic is not unlocked."
        end
        d.EquippedCosmetic = id
        self:Notice(d, "Cosmetic equipped: " .. MonetizationCatalog.Cosmetics[id].Name, "Cosmetic")
        return true
    elseif action == "Click" then
        if d.Runtime.BurstEndsAt &lt;= now then
            d.Runtime.Charge += 1
            if d.Runtime.Charge &gt;= self.P.Burst.Clicks then
                d.Runtime.Charge = 0
                d.Runtime.BurstEndsAt = now + self:BurstDuration(d)
                self:Notice(
                    d,
                    "Overdrive active: natural x"
                        .. self.P.Burst.Multiplier
                        .. " production. It stacks with your paid x2 boost.",
                    "Burst"
                )
            end
        end
        local gained = self:Add(d, self:ClickPower(d, now))
        d.TotalClicks += 1
        d.Runtime.LastClickGain = gained
        return true
    elseif action == "AutoBuy" then
        if type(id) ~= "boolean" then
            return false, "Invalid Auto Buy setting."
        end
        if id and not self:AutoBuyUnlocked(d) then
            return false, "Auto Buy requires 8 worlds and the 500M Energy Research upgrade."
        end
        d.AutoBuyEnabled = id
        d.Runtime.AutoBuyAccumulator = 0
        self:Notice(
            d,
            id and "Auto Buy enabled. Research upgrades buy automatically every second."
                or "Auto Buy paused. Save Energy for your next goal.",
            "Confirm"
        )
        return true
    elseif action == "Buy" then
        local def = find(self.Catalog, id)
        if not def then
            return false, "Unknown producer."
        end
        if self:WorldCount(d) &lt; (def.RequiredWorld or 1) then
            return false, "Unlock more worlds first."
        end
        local limit = quantity == "Max" and 100 or quantity == 10 and 10 or 1
        local bought = self:BuyProducer(d, def, limit)
        if bought == 0 then
            return false, "Not enough " .. string.lower(self.Config.Currency.Name) .. "."
        end
        self:Notice(
            d,
            "Purchased " .. bought .. " " .. ((self.Config.UpgradePresentation[id] or {}).Name or id),
            "Purchase"
        )
        return true
    elseif action == "Zone" then
        local z = find(self.Config.Zones, id)
        if not z then
            return false, "Unknown world."
        end
        if not d.UnlockedZones[id] then
            if d.Currency &lt; z.UnlockCost then
                return false, "Not enough to unlock " .. z.Name .. "."
            end
            d.Currency -= z.UnlockCost
            d.UnlockedZones[id] = true
            self:Notice(d, z.Name .. " unlocked! x" .. z.Multiplier .. " production", "World")
        end
        d.CurrentZone = id
        return true
    elseif action == "Research" or action == "Permanent" then
        local defs = self.P[action]
        local def = find(defs, id)
        if not def then
            return false, "Unknown upgrade."
        end
        local level = d[action][id] or 0
        if level &gt;= def.Max then
            return false, "Already at maximum level."
        end
        if action == "Research" and id == self.P.AutoBuy.ResearchId
            and self:WorldCount(d) &lt; self.P.AutoBuy.RequiredWorld then
            return false, "Own " .. self.P.AutoBuy.RequiredWorld .. " worlds before buying Auto Buy."
        end
        local cost = self:Cost(def, level, d)
        local wallet = action == "Permanent" and "Stars" or "Currency"
        if d[wallet] &lt; cost then
            return false,
                "Not enough " .. (wallet == "Stars" and "stars" or string.lower(self.Config.Currency.Name)) .. "."
        end
        d[wallet] -= cost
        d[action][id] = level + 1
        if action == "Research" and id == self.P.AutoBuy.ResearchId then
            d.AutoBuyEnabled = true
            d.Runtime.AutoBuyAccumulator = 0
            self:Notice(d, "Auto Buy permanently unlocked! It buys research; pause it in Research to save Energy.", "Research")
        else
            self:Notice(d, def.Name .. " upgraded to level " .. (level + 1), "Research")
        end
        return true
    elseif action == "Expedition" then
        if d.Expedition then
            return false, "Finish your current expedition first."
        end
        local def = find(self.P.Expeditions, id)
        if not def then
            return false, "Unknown expedition."
        end
        if self:WorldCount(d) &lt; def.World then
            return false, "Unlock more worlds first."
        end
        if d.Currency &lt; def.Cost then
            return false, "Not enough to launch this expedition."
        end
        local multiplier = (1 + (d.Research.Logistics or 0) * 0.15) * (1 + (d.Permanent.Cargo or 0) * 0.25)
        local baseReward = self:GameplayEnergyReward(d, def.Reward, def.ClickCount or 0, def.IncomeSeconds or 0, now)
        local reward = math.min(self.Config.MaximumCurrency, baseReward * multiplier)
        d.Currency -= def.Cost
        d.Expedition = { Id = id, EndsAt = now + def.Duration, Reward = reward }
        self:Notice(d, def.Name .. " is on its way.", "Expedition")
        return true
    elseif action == "ClaimExpedition" then
        if not d.Expedition or now &lt; d.Expedition.EndsAt then
            return false, "Your expedition is still traveling."
        end
        local reward = d.Expedition.Reward
        d.Expedition = nil
        self:Add(d, reward)
        d.TotalExpeditions += 1
        self:Notice(d, "Expedition complete! Cargo collected.", "Reward")
        return true
    elseif action == "Achievement" or action == "Daily" then
        local def = find(action == "Daily" and self.P.Daily or self.P.Achievements, id)
        if not def then
            return false, "Unknown reward."
        end
        local claimed = action == "Daily" and d.Daily.Claimed or d.ClaimedAchievements
        local metric = self:Metric(d, def.Metric) - (action == "Daily" and (d.Daily.Baseline[def.Metric] or 0) or 0)
        if claimed[id] then
            return false, "Reward already collected."
        end
        if metric &lt; def.Goal then
            return false, "Objective is not complete yet."
        end
        claimed[id] = true
        self:Add(d, self:GameplayEnergyReward(d, def.Energy or 0, def.ClickCount or 0, def.IncomeSeconds or 0, now))
        d.Stars = math.min(self.Config.MaximumCurrency, d.Stars + (def.Stars or 0))
        self:Notice(d, def.Name .. " reward collected!", "Achievement")
        return true
    elseif action == "Collect" then
        if d.Runtime.EventEndsAt &lt;= now or id ~= d.Runtime.EventNonce then
            return false, "That bonus has passed."
        end
        d.Runtime.EventEndsAt = 0
        self:Add(d, self:GameplayEnergyReward(d, 25, 10, 15, now))
        self:Notice(d, "Bonus collected!", "Collect")
        return true
    elseif action == "Rebirth" then
        if not self.Config.Prestige.Enabled or d.Currency &lt; self:RebirthCost(d) then
            return false, "You need more Energy for Ascension."
        end
        local stars = self:RebirthGain(d)
        d.Stars = math.min(self.Config.MaximumCurrency, d.Stars + stars)
        d.Prestiges += 1
        d.Currency = 0
        d.RunEarned = 0
        d.Upgrades = {}
        -- Auto Buy is a permanent research unlock; keep its level and on/off preference.
        local autoBuyResearchId = self.P.AutoBuy.ResearchId
        local autoBuyLevel = d.Research[autoBuyResearchId] or 0
        d.Research = { [autoBuyResearchId] = autoBuyLevel }
        d.Runtime.AutoBuyAccumulator = 0
        d.Runtime.Charge = 0
        d.Runtime.BurstEndsAt = 0
        self:Notice(d, "Ascension complete! +" .. stars .. " stars. Permanent upgrades are waiting.", "Rebirth")
        return true
    end
    return false, "Unknown action."
end
function Economy:Snapshot(d, now, saveMode, profileWritable)
    local canSellDeveloperProducts, productsUnavailableReason =
        MonetizationRules.DeveloperProductAvailability(profileWritable, d.Runtime.ReceiptLedgerBytes or 2)
    local s = {
        Currency = d.Currency,
        LifetimeCurrency = d.LifetimeCurrency,
        RunEarned = d.RunEarned,
        TotalClicks = d.TotalClicks,
        ClickPower = self:ClickPower(d, now),
        PassiveRate = self:Passive(d, now),
        BasePassiveRate = self:Passive(d, now, true),
        PaidBoostEndsAt = d.PaidBoostEndsAt or 0,
        OwnedPasses = clone(d.Runtime.OwnedPasses or {}),
        EquippedCosmetic = d.EquippedCosmetic,
        CanSellDeveloperProducts = canSellDeveloperProducts,
        DeveloperProductsUnavailableReason = productsUnavailableReason,
        CurrentZone = d.CurrentZone,
        ZoneMultiplier = self:Zone(d).Multiplier,
        Prestiges = d.Prestiges,
        Stars = d.Stars,
        PrestigeEnabled = self.Config.Prestige.Enabled,
        PrestigeCost = self:RebirthCost(d),
        RebirthGain = self:RebirthGain(d),
        CanPrestige = self.Config.Prestige.Enabled and d.Currency &gt;= self:RebirthCost(d),
        PrestigeMultiplier = self:Mastery(d),
        BurstCharge = d.Runtime.Charge,
        BurstEndsAt = d.Runtime.BurstEndsAt,
        BurstDuration = self:BurstDuration(d),
        BurstNeeded = self.P.Burst.Clicks,
        BurstMultiplier = self.P.Burst.Multiplier,
        EventEndsAt = d.Runtime.EventEndsAt,
        EventNonce = d.Runtime.EventNonce,
        ServerTime = now,
        SaveMode = saveMode,
        NoticeSerial = d.Runtime.NoticeSerial,
        Notice = d.Runtime.Notice,
        NoticeKind = d.Runtime.NoticeKind,
        LastClickGain = d.Runtime.LastClickGain or 0,
        OfflineEarned = d.Runtime.OfflineEarned,
        OfflineSeconds = d.Runtime.OfflineSeconds,
        Expedition = d.Expedition and clone(d.Expedition) or nil,
        Upgrades = {},
        Zones = {},
        Research = {},
        Permanent = {},
        Expeditions = {},
        Achievements = {},
        Daily = {},
        Claimable = 0,
    }
    local worlds = self:WorldCount(d)
    s.AutoBuyWorldsMet = worlds &gt;= self.P.AutoBuy.RequiredWorld
    s.AutoBuyRequiredWorld = self.P.AutoBuy.RequiredWorld
    s.AutoBuyUnlocked = self:AutoBuyUnlocked(d)
    s.AutoBuyEnabled = s.AutoBuyUnlocked and d.AutoBuyEnabled == true
    for _, v in ipairs(self.Catalog) do
        s.Upgrades[v.Id] = {
            Owned = d.Upgrades[v.Id] or 0,
            Cost = self:Cost(v, d.Upgrades[v.Id] or 0, d, true),
            Locked = worlds &lt; (v.RequiredWorld or 1),
            RequiredWorld = v.RequiredWorld or 1,
        }
    end
    for i, z in ipairs(self.Config.Zones) do
        s.Zones[i] = {
            Id = z.Id,
            Name = z.Name,
            UnlockCost = z.UnlockCost,
            Multiplier = z.Multiplier,
            Unlocked = d.UnlockedZones[z.Id] == true,
            Current = d.CurrentZone == z.Id,
        }
    end
    for _, kind in ipairs({ "Research", "Permanent" }) do
        for i, v in ipairs(self.P[kind]) do
            local level = d[kind][v.Id] or 0
            s[kind][i] = {
                Id = v.Id,
                Name = v.Name,
                Description = v.Description,
                Level = level,
                Max = v.Max,
                Cost = self:Cost(v, level, d),
                Locked = kind == "Research" and v.Id == self.P.AutoBuy.ResearchId
                    and worlds &lt; self.P.AutoBuy.RequiredWorld,
                RequiredWorld = kind == "Research" and v.Id == self.P.AutoBuy.ResearchId
                    and self.P.AutoBuy.RequiredWorld or nil,
            }
        end
    end
    for i, v in ipairs(self.P.Expeditions) do
        local multiplier = (1 + (d.Research.Logistics or 0) * 0.15) * (1 + (d.Permanent.Cargo or 0) * 0.25)
        local baseReward = self:GameplayEnergyReward(d, v.Reward, v.ClickCount or 0, v.IncomeSeconds or 0, now)
        s.Expeditions[i] = {
            Id = v.Id,
            Name = v.Name,
            Description = v.Description,
            Duration = v.Duration,
            Cost = v.Cost,
            Locked = worlds &lt; v.World,
            RequiredWorld = v.World,
            Reward = math.min(self.Config.MaximumCurrency, baseReward * multiplier),
        }
    end
    for _, kind in ipairs({ "Achievements", "Daily" }) do
        for i, v in ipairs(self.P[kind]) do
            local progress =
                math.max(0, self:Metric(d, v.Metric) - (kind == "Daily" and (d.Daily.Baseline[v.Metric] or 0) or 0))
            local claimed = kind == "Daily" and d.Daily.Claimed[v.Id] == true
                or kind == "Achievements" and d.ClaimedAchievements[v.Id] == true
            local ready = not claimed and progress &gt;= v.Goal
            if ready then
                s.Claimable += 1
            end
            local energy = self:GameplayEnergyReward(d, v.Energy or 0, v.ClickCount or 0, v.IncomeSeconds or 0, now)
            s[kind][i] = {
                Id = v.Id,
                Name = v.Name,
                Progress = math.min(progress, v.Goal),
                Goal = v.Goal,
                Claimed = claimed,
                Ready = ready,
                Energy = energy,
                Stars = v.Stars or 0,
            }
        end
    end
    local first = self.Catalog[1]
    local second = self.Catalog[2]
    if (d.Upgrades[first.Id] or 0) == 0 then
        s.Objective = "First goal: buy " .. ((self.Config.UpgradePresentation[first.Id] or {}).Name or first.Id)
    elseif second and (d.Upgrades[second.Id] or 0) == 0 then
        s.Objective = "Next: automate with " .. ((self.Config.UpgradePresentation[second.Id] or {}).Name or second.Id)
    elseif s.Claimable &gt; 0 then
        s.Objective = "Journal: " .. s.Claimable .. " rewards ready to collect"
    elseif not d.Expedition then
        s.Objective = "Send an expedition for extra income"
    else
        s.Objective = "Keep growing. A new world is within reach."
    end
    return s
end
return Economy
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXb4bde4af95ca4c7bb616c850be63c8a8">
        <Properties>
          <string name="Name">MonetizationReceiptService</string>
          <ProtectedString name="Source">-- Atomic Developer Product receipt commits against the current profile lease.
local Rules = require(game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit"):WaitForChild("MonetizationRules"))
local HttpService = game:GetService("HttpService")
local MAX_PROFILE_CHARACTERS = 3_800_000
local Legacy = {}

function Legacy.Commit(store, userId, sessionId, profileSnapshot, offer, purchaseId, gameNow, leaseNow, maxCurrency, leaseSeconds, maxProfileCharacters)
	maxProfileCharacters = type(maxProfileCharacters) == "number" and maxProfileCharacters &gt; 0 and maxProfileCharacters or MAX_PROFILE_CHARACTERS
	if not store or type(store.UpdateAsync) ~= "function"
		or type(userId) ~= "number" or type(sessionId) ~= "string"
		or type(profileSnapshot) ~= "table" or type(offer) ~= "table" or offer.Kind ~= "Product"
		or type(offer.Id) ~= "number" or offer.Id &lt;= 0 or offer.Id % 1 ~= 0
		or type(purchaseId) ~= "string" or type(leaseNow) ~= "number"
		or type(leaseSeconds) ~= "number" or leaseSeconds &lt;= 0 then
		return "Retry"
	end

	local callbackStatus
	local ok, saved = pcall(function()
		return store:UpdateAsync("User_" .. tostring(userId), function(old)
			if type(old) ~= "table" then
				callbackStatus = "Retry"
				return nil
			end
			if old.Version ~= nil and old.Version ~= 1 and old.Version ~= 2 then callbackStatus = "Retry"; return nil end
			local lease = old._Session
			if type(lease) ~= "table" or lease.Id ~= sessionId
				or type(lease.ExpiresAt) ~= "number" or lease.ExpiresAt &lt;= leaseNow then
				callbackStatus = "Retry"
				return nil
			end

			local oldReceipts = old.ProcessedReceipts
			local existing = type(oldReceipts) == "table" and oldReceipts[purchaseId]
			if existing ~= nil then
				if type(existing) == "table" and existing.Status == "Granted" and existing.PurchaseId == purchaseId
					and (existing.ProductId == nil or existing.ProductId == offer.Id) then
					callbackStatus = "Duplicate"
					return old
				end
				callbackStatus = "Retry"
				return nil
			end

			local updated, result = Rules.ApplyProduct(profileSnapshot, offer, purchaseId, gameNow, maxCurrency)
			if result.Status == "Deferred" then
				callbackStatus = "Deferred"
				return nil
			end
			if result.Status == "Invalid" then
				callbackStatus = "Invalid"
				return nil
			end
			if result.Status == "Duplicate" then
				updated._Session = { Id = sessionId, ExpiresAt = leaseNow + leaseSeconds }
				callbackStatus = "Duplicate"
				return updated
			end
			if result.Status ~= "Granted" then
				callbackStatus = "Retry"
				return nil
			end

			updated._Session = { Id = sessionId, ExpiresAt = leaseNow + leaseSeconds }
			local encodedOk, encoded = pcall(function() return HttpService:JSONEncode(updated) end)
			if not encodedOk or #encoded &gt; maxProfileCharacters then
				callbackStatus = "Capacity"
				return nil
			end
			callbackStatus = "Granted"
			return updated
		end)
	end)

	if not ok then return "Retry" end
	if type(saved) ~= "table" then return callbackStatus or "Retry" end
	local receipts = saved.ProcessedReceipts
	local receipt = type(receipts) == "table" and receipts[purchaseId]
	if type(receipt) ~= "table" or receipt.Status ~= "Granted" or receipt.PurchaseId ~= purchaseId then
		return callbackStatus == "Deferred" and "Deferred" or "Retry"
	end
	if callbackStatus == "Duplicate" then return "Duplicate", receipt end
	return "Granted", receipt
end

-- Version 3 delivery persists the complete account and a single root receipt ledger.
local AccountProducts = require(script.Parent.AccountMonetization)
local AccountStore = require(script.Parent.AccountStore)
local U = require(game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit").StarUtil)
local Service = {}
function Service.Commit(store,userId,sessionId,snapshot,offer,purchaseId,gameNow,leaseNow,maxCurrency,leaseSeconds,maxCharacters)
    if type(snapshot)~="table" then return "Retry" end
    if snapshot.Version~=3 then
        if snapshot.Version~=nil and snapshot.Version~=1 and snapshot.Version~=2 then return "Retry" end
        return Legacy.Commit(store,userId,sessionId,snapshot,offer,purchaseId,gameNow,leaseNow,maxCurrency,leaseSeconds,maxCharacters)
    end
    if not store or type(store.UpdateAsync)~="function" or type(userId)~="number" or type(purchaseId)~="string" then return "Retry" end
    local proposed,receipt=AccountProducts.ApplyProduct(snapshot,offer,purchaseId,gameNow,maxCurrency)
    if receipt.Status=="Deferred" or receipt.Status=="Invalid" then return receipt.Status end
    local duplicate
    local proxy={}
    function proxy:UpdateAsync(key,callback)
        return store:UpdateAsync(key,function(old)
            local lease=type(old)=="table" and old._Session
            local prior=type(old)=="table" and type(old.ProcessedReceipts)=="table" and old.ProcessedReceipts[purchaseId]
            if prior~=nil then
                if type(lease)=="table" and lease.Id==sessionId and type(lease.ExpiresAt)=="number" and lease.ExpiresAt&gt;leaseNow
                    and type(prior)=="table" and prior.Status=="Granted" and prior.PurchaseId==purchaseId
                    and (prior.ProductId==nil or prior.ProductId==offer.Id) then
                    duplicate=U.Clone(prior);return old
                end
                return nil
            end
            return callback(old)
        end)
    end
    local status,saved=AccountStore.Commit(proxy,"User_"..tostring(userId),sessionId,snapshot.Revision or 0,proposed,"receipt:"..purchaseId,leaseNow,leaseSeconds)
    if duplicate then return "Duplicate",duplicate,saved end
    if status=="Capacity" then return "Capacity" end
    if status~="Committed" then return "Retry" end
    local granted=saved.ProcessedReceipts[purchaseId]
    if not granted then return "Retry" end
    return "Granted",granted,saved
end
return Service
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX117a9a1d444c4e7ba865cbd933aa09c4">
        <Properties>
          <string name="Name">StarAccountRuntime</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit")
local A=require(script.Parent.AccountProfile)
local Store=require(script.Parent.AccountStore)
local Stellar=require(script.Parent.StellarProgression)
local Receipts=require(script.Parent.MonetizationReceiptService)
local Rules=require(Shared.MonetizationRules)
local U=require(Shared.StarUtil)
local Http=game:GetService("HttpService")
local R={};R.__index=R
function R.new(account,context)
    local self=setmetatable({Account=account,Context=context,Busy=false,Unresolved=false,Closing=false,CheckoutUntil=0,
        SaveMode=context.SaveMode or "Temporary",Writable=context.Writable==true,Identity=Http:GenerateGUID(false)},R)
    A.Project(account,account.ActiveSystemId,context.GameClock())
    return self
end
function R:OwnershipToken()return {Identity=self.Identity,Generation=self.Account.DiscoveryGeneration}end
function R:ApplyOwnership(owned,token)
    if not token or token.Identity~=self.Identity or token.Generation~=self.Account.DiscoveryGeneration or self.Closing then return false end
    if self.Busy then self.PendingOwnership={Owned=U.Clone(owned),Token=token};return false end
    local id=self.Account.ActiveSystemId;local d=A.Project(self.Account,id,self.Context.GameClock())
    A.Economy(id):ApplyPassOwnership(d,owned,true)
    self.Account.OwnedPasses=U.Clone(d.Runtime.OwnedPasses)
    return true
end
function R:ConfirmPassPurchase(key)
    local id=self.Account.ActiveSystemId;local d=A.Project(self.Account,id,self.Context.GameClock())
    if self.Busy then return self:ApplyOwnership({[key]=true},self:OwnershipToken())end
    if not A.Economy(id):ConfirmPassPurchase(d,key)then return false end
    self.Account.OwnedPasses=U.Clone(d.Runtime.OwnedPasses);return true
end
function R:_finish()
    if self.Unresolved then return end
    self.Busy=false
    local pending=self.PendingOwnership;self.PendingOwnership=nil
    if pending then self:ApplyOwnership(pending.Owned,pending.Token)end
end
function R:_adopt(saved,now,preserveRuntime)
    local a,err=A.Normalize(saved,now)
    if not a then self.Unresolved=true;self.Writable=false;self.SaveMode="Temporary";self.Error=err;return false end
    if preserveRuntime and a.DiscoveryGeneration==self.Account.DiscoveryGeneration then
        for id,run in pairs(a.Systems)do
            if self.Account.Systems[id]then run.Runtime=U.Clone(self.Account.Systems[id].Runtime)end
        end
    end
    self.Account=a;A.Project(a,a.ActiveSystemId,now);return true
end
function R:_canTransact()
    return self.Writable and self.SaveMode=="Cloud" and not self.Busy and not self.Unresolved and not self.Closing
end
function R:_commit(proposed,kind,operationId,now,release)
    if not self:_canTransact()then return "Unavailable"end
    self.Busy=true
    local rollback=A.Serialize(self.Account,now);local encoded=A.Serialize(proposed,now)
    if release then rollback._ReleaseSession=true;encoded._ReleaseSession=true end
    local c=self.Context;local base=self.Account.Revision
    local status,saved=Store.Commit(c.Store,c.UserKey,c.SessionId,base,encoded,operationId,c.LeaseClock(),c.LeaseSeconds or 180)
    if status=="Retry"then status,saved=Store.Resolve(c.Store,c.UserKey,c.SessionId,base,operationId,rollback,c.LeaseClock(),c.LeaseSeconds or 180)end
    if status=="Committed" or status=="NotCommitted" then
        local preserve=status=="NotCommitted" or (kind~="DiscoverSystem" and kind~="TravelSystem")
        if not self:_adopt(saved,now,preserve)then return "Conflict"end
        self.SaveMode="Cloud";self:_finish()
    elseif status=="Capacity"then self:_finish()
    else self.Unresolved=true;self.Writable=false;self.SaveMode="Temporary";self.Error="Saving ownership or transaction outcome could not be verified."end
    return status
end
function R:Tick(now,dt)
    if self.Busy or self.Unresolved or self.Closing then return {}end
    local id=self.Account.ActiveSystemId;local d=A.Project(self.Account,id,now);local e=A.Economy(id)
    e:Tick(d,now,dt)
    local clicks,remainder=Rules.AdvanceAutoTap(d.Runtime.OwnedPasses,d.Runtime.AutoTapAccumulator or 0,dt)
    d.Runtime.AutoTapAccumulator=remainder
    local gains={}
    for _=1,clicks do
        if e:Action(d,"Click",nil,nil,now) and (d.Runtime.LastClickGain or 0)&gt;0 then table.insert(gains,d.Runtime.LastClickGain)end
    end
    return gains
end
function R:Transition(kind,target,operationId,now)
    if self.Context.TransitionsEnabled==false or self.CheckoutUntil&gt;now or not self:_canTransact()then return "Unavailable"end
    local proposed,err
    if kind=="DiscoverSystem"then proposed,err=A.ProposeDiscovery(self.Account,target,now)
    elseif kind=="TravelSystem"then proposed,err=A.ProposeTravel(self.Account,target,now)
    else return "Unavailable"end
    if not proposed then return "Unavailable",err end
    proposed.LastTransition={Id=operationId,Kind=kind,FromSystemId=self.Account.ActiveSystemId,ToSystemId=target,Generation=proposed.DiscoveryGeneration}
    local status=self:_commit(proposed,kind,operationId,now,false)
    if status=="Committed"then
        local id=self.Account.ActiveSystemId
        A.Economy(id):Notice(self.Account.Systems[id],kind=="DiscoverSystem" and "New star discovered! Your interstellar upgrades remain." or "Travel complete. Your progress is restored.","World")
    end
    return status
end
function R:Action(kind,id,quantity,now)
    if self.Busy or self.Unresolved or self.Closing then return false,"Please wait for saving to finish."end
    if kind=="CheckoutBusy"then
        if type(id)~="boolean"then return false end
        self.CheckoutUntil=id and now+120 or 0;return true
    end
    if kind=="DiscoverSystem" or kind=="TravelSystem"then
        local status,err=self:Transition(kind,id,Http:GenerateGUID(false),now)
        return status=="Committed",err or (status~="Committed" and "Travel could not be saved. Your current progress is unchanged." or nil)
    end
    if kind=="StellarResearch" or kind=="StellarAscension"then
        if self.Context.TransitionsEnabled==false or not self:_canTransact()then return false,"Interstellar upgrades require cloud saving."end
        if type(id)~="string" or type(quantity)~="string"then return false,"Invalid upgrade."end
        local section=kind=="StellarResearch" and "Research" or "Ascension"
        local proposed,err=Stellar.Purchase(self.Account,self.Account.ActiveSystemId,id,section,quantity)
        if not proposed then return false,err end
        local status=self:_commit(proposed,kind,Http:GenerateGUID(false),now,false)
        if status=="Committed"then A.Economy(self.Account.ActiveSystemId):Notice(self.Account.Systems[self.Account.ActiveSystemId],"Interstellar upgrade purchased for a neighboring star.","Research")end
        return status=="Committed",status~="Committed" and "This upgrade could not be saved." or nil
    end
    local active=self.Account.ActiveSystemId;local d=A.Project(self.Account,active,now)
    local ok,err=A.Economy(active):Action(d,kind,id,quantity,now)
    if ok then
        if kind=="AutoBuy" then A.CaptureAutoBuy(self.Account,active,id)
        elseif kind=="Research" and id=="AutoBuy"then A.CaptureAutoBuy(self.Account,active,true)
        elseif kind=="EquipCosmetic"then self.Account.EquippedCosmetic=d.EquippedCosmetic end
    end
    return ok,err
end
function R:Save(release)
    if self.Closing then return "Unavailable"end
    local now=self.Context.GameClock()
    local status=self:_commit(self.Account,"Save",Http:GenerateGUID(false),now,release)
    if release and (status=="Committed" or status=="NotCommitted")then self.Closing=true;self.Writable=false end
    return status
end
function R:ProcessReceipt(offer,purchaseId,now)
    if type(purchaseId)~="string" or #purchaseId==0 or #purchaseId&gt;128 then return "Retry"end
    local existing=self.Account.ProcessedReceipts[purchaseId]
    if existing then return (existing.ProductId==nil or existing.ProductId==offer.Id) and "Duplicate" or "Retry",existing end
    if not self:_canTransact()then return "Retry"end
    self.Busy=true
    local c=self.Context;local rollback=A.Serialize(self.Account,now);local base=self.Account.Revision
    local status,receipt,saved=Receipts.Commit(c.Store,c.UserId,c.SessionId,rollback,offer,purchaseId,now,c.LeaseClock(),1e18,c.LeaseSeconds or 180)
    if status=="Retry"then
        local resolved,record=Store.Resolve(c.Store,c.UserKey,c.SessionId,base,"receipt:"..purchaseId,rollback,c.LeaseClock(),c.LeaseSeconds or 180)
        if resolved=="Committed"then status="Granted";saved=record;receipt=record.ProcessedReceipts[purchaseId]
        elseif resolved=="NotCommitted"then saved=record end
        if resolved~="Committed" and resolved~="NotCommitted"then self.Unresolved=true;self.Writable=false;self.SaveMode="Temporary"end
    end
    if saved then
        if not self:_adopt(saved,now,true)then return "Retry"end
    end
    self:_finish()
    if status=="Granted" or status=="Duplicate"then
        self.CheckoutUntil=0
        local active=self.Account.ActiveSystemId;local e=A.Economy(active)
        local message=e:ProductPurchaseNotice(status,offer)
        if message then e:Notice(self.Account.Systems[active],message,"Purchase")end
    end
    return status,receipt
end
function R:Snapshot(now)
    local s=A.Snapshot(self.Account,now,self.SaveMode,self.Writable)
    s.TransactionBusy=self.Busy or self.CheckoutUntil&gt;now
    s.CanTravel=self:_canTransact() and self.Context.TransitionsEnabled~=false and self.CheckoutUntil&lt;=now
    s.ReconnectRequired=self.Unresolved
    s.CanSellDeveloperProducts=s.CanSellDeveloperProducts and not self.Busy
    return s
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9b751d3c8b894887b368d070ed1064da">
        <Properties>
          <string name="Name">StellarProgression</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit")
local Stars=require(Shared.StarSystemCatalog)
local Catalog=require(Shared.StellarUpgradeCatalog)
local U=require(Shared.StarUtil)
local P={}
local function level(value,max)
    return U.Finite(value) and math.floor(math.clamp(value,0,max)) or 0
end
function P.Cost(section,id,current)
    local def=Catalog.Get(section,id)
    if not def or not U.Finite(current) or current&lt;0 or current%1~=0 or current&gt;=def.Max then return nil end
    return math.max(1,math.floor(math.min(1e18,def.Cost*def.Growth^current)+.5))
end
function P.Incoming(account,target)
    local sums={Clicks=0,Passive=0,Production=0,Offline=0}
    if account.UnlockedSystems[target] then
        for source,targets in pairs(account.StellarLinks or {})do
            local link=type(targets)=="table" and targets[target]
            if account.UnlockedSystems[source] and Stars.AreAdjacent(source,target) and type(link)=="table" then
                for _,section in ipairs({"Research","Ascension"})do
                    for _,def in ipairs(Catalog[section])do
                        local levels=type(link[section])=="table" and link[section][def.Id]
                        sums[def.Effect]+=level(levels,def.Max)*def.Amount
                    end
                end
            end
        end
    end
    return {ClickMultiplier=1+sums.Clicks,PassiveMultiplier=1+sums.Passive,ProductionMultiplier=1+sums.Production,OfflineSeconds=sums.Offline}
end
function P.Purchase(account,source,target,section,id)
    local def=Catalog.Get(section,id)
    if source~=account.ActiveSystemId or not def or not Stars.AreAdjacent(source,target)
        or account.UnlockedSystems[source]~=true or account.UnlockedSystems[target]~=true then
        return nil,"Discover a neighboring star before upgrading it."
    end
    local run=account.Systems[source]
    local targets=(account.StellarLinks or {})[source]
    local link=targets and targets[target]
    local levels=link and link[section]
    local current=level(levels and levels[id],def.Max)
    local cost=P.Cost(section,id,current)
    if not cost then return nil,"This interstellar upgrade is at its maximum level." end
    if not run or not U.Finite(run[def.Wallet]) or run[def.Wallet]&lt;cost then return nil,"Not enough "..(def.Wallet=="Stars" and "Ascend Stars" or "Energy").."." end
    local result=U.Clone(account)
    result.Systems[source][def.Wallet]-=cost
    result.StellarLinks=result.StellarLinks or {}
    result.StellarLinks[source]=result.StellarLinks[source] or {}
    result.StellarLinks[source][target]=result.StellarLinks[source][target] or {Research={},Ascension={}}
    result.StellarLinks[source][target][section]=result.StellarLinks[source][target][section] or {}
    result.StellarLinks[source][target][section][id]=current+1
    return result
end
return P
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBXccd23389c89545c3802e902c81aedf54">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBXcaab1ffa6ac34bc98d9200ecdc0f5710">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX6747980e59ca4afeb40e73049d30813b">
        <Properties>
          <string name="Name">ClickerClient</string>
          <ProtectedString name="Source">-- Persistent platform listeners; star views are disposed by the controller.
local Players=game:GetService("Players")
local Marketplace=game:GetService("MarketplaceService")
local Input=game:GetService("UserInputService")
local StarterGui=game:GetService("StarterGui")
local Kit=game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit")
local Rules=require(Kit.MonetizationRules)
local Offers=require(Kit.MonetizationCatalog)
local Controller=require(script.Parent:WaitForChild("StarClientController"))
local Remotes=Kit:WaitForChild("Remotes")
local player=Players.LocalPlayer
local connections,alive={},true
local controller
local function connect(signal,fn)
    local c=signal:Connect(fn);table.insert(connections,c);return c
end
local function promptOffer(key,c)
    local row=c.View.ShopOffers[key];local s=c.State
    if not row or not s or c.Checkout or c.PendingTransition or s.TransactionBusy then return end
    local offer=row.Offer
    local owned=offer.Kind=="Pass" and s.OwnedPasses and s.OwnedPasses[key]==true or false
    local active=offer.Grant and offer.Grant.Type=="PaidBoost" and(s.PaidBoostEndsAt or 0)&gt;workspace:GetServerTimeNow() or false
    local canFit=not offer.Grant or offer.Grant.Type~="Currency" or(s.Currency or 0)+offer.Grant.Amount&lt;=c.View.Config.MaximumCurrency
    local decision=Rules.OfferState(offer,c.Prices[key]~=nil,owned,active,canFit,
        offer.Kind~="Product" or s.CanSellDeveloperProducts~=false,s.DeveloperProductsUnavailableReason)
    if not decision.CanPrompt then
        local messages={WalletFull="Spend some Energy before buying another pack.",
            PersistenceUnavailable="Purchases need cloud saving. Rejoin a published server with saving enabled.",
            StorageLimit="Purchases are paused because receipt history is near its storage limit.",
            Owned="You already own this pass."}
        c:Toast(messages[decision.Status] or "Roblox has not returned a price for this offer yet.");return
    end
    c:SetCheckout(true)
    local ok=pcall(function()
        if offer.Kind=="Pass" then Marketplace:PromptGamePassPurchase(player,offer.Id)
        else Marketplace:PromptProductPurchase(player,offer.Id)end
    end)
    if not ok then c:SetCheckout(false);c:Toast("Roblox could not open the purchase prompt. Please try again.")end
end
controller=Controller.new(player:WaitForChild("PlayerGui"),{
    SendAction=function(...)Remotes.RequestAction:FireServer(...)end,PromptOffer=promptOffer})
connect(Remotes.StateUpdate.OnClientEvent,function(s)controller:ApplySnapshot(s)end)
connect(Input.InputBegan,function(input,processed)
    if not processed and(input.KeyCode==Enum.KeyCode.Space or input.KeyCode==Enum.KeyCode.ButtonA)then controller:Click()end
    if(input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch)
        and controller:OverWorldList(input)then controller:CancelWorldScroll();controller:UpdateWorldScrollButtons()end
end)
connect(Input.InputChanged,function(input)
    if input.UserInputType==Enum.UserInputType.MouseWheel and controller:OverWorldList(input)then
        controller:CancelWorldScroll();controller:UpdateWorldScrollButtons()
    end
end)
connect(Marketplace.PromptGamePassPurchaseFinished,function(who)
    if who==player then controller:SetCheckout(false)end
end)
connect(Marketplace.PromptProductPurchaseFinished,function(userId)
    if userId==player.UserId then controller:SetCheckout(false)end
end)
for key,row in pairs(controller.View.ShopOffers)do
    local offer=row.Offer
    if offer.Id&gt;0 then task.spawn(function()
        local ok,info=pcall(function()return Marketplace:GetProductInfoAsync(offer.Id,
            offer.Kind=="Pass" and Enum.InfoType.GamePass or Enum.InfoType.Product)end)
        if alive and ok and type(info)=="table" and type(info.PriceInRobux)=="number"then controller:SetPrice(key,info.PriceInRobux)end
    end)end
end
local viewportConnection
local function setCamera()
    local camera=workspace.CurrentCamera
    if camera then
        camera.CameraType=Enum.CameraType.Scriptable
        camera.CFrame=CFrame.new(0,100,0)*CFrame.Angles(-math.pi/2,0,0)
        controller:SetViewport(camera.ViewportSize)
    end
end
local function connectCamera()
    if viewportConnection then viewportConnection:Disconnect()end
    setCamera()
    if workspace.CurrentCamera then viewportConnection=workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(setCamera)end
end
connect(workspace:GetPropertyChangedSignal("CurrentCamera"),connectCamera);connectCamera()
pcall(function()
    for _,kind in ipairs({Enum.CoreGuiType.Backpack,Enum.CoreGuiType.PlayerList,Enum.CoreGuiType.Chat,Enum.CoreGuiType.Health})do
        StarterGui:SetCoreGuiEnabled(kind,false)
    end
end)
task.spawn(function()
    local module=player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule",10)
    if module and alive then
        local ok,controls=pcall(function()return require(module):GetControls()end)
        if ok and alive then controls:Disable()end
    end
end)
task.spawn(function()
    local previous=os.clock()
    while alive do
        task.wait(Rules.AutoTapInterval)
        if not alive then break end
        local now=os.clock();controller:AutoTapStep(now-previous);previous=now
    end
end)
connect(script.Destroying,function()
    alive=false
    for _,c in ipairs(connections)do c:Disconnect()end
    if viewportConnection then viewportConnection:Disconnect()end
    controller:Destroy()
end)
Remotes.RequestSnapshot:FireServer()
task.spawn(function()
    for _=1,20 do
        if controller.State or not alive then return end
        task.wait(1)
        if alive then Remotes.RequestSnapshot:FireServer()end
    end
    if alive and not controller.State then controller:Toast("Connection delayed. Please rejoin.")end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXb3419f652bd946c088a53901a9708b1c">
        <Properties>
          <string name="Name">Effects</string>
          <ProtectedString name="Source">local function create(providedConfig)
-- Bounded client-only animation. Rewards and timers remain authoritative on the server.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local Kit = game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit")
local Config = providedConfig or require(Kit.ThemeConfig)
local Art = require(Kit.Art).ForConfig(Config)
local T = Config.Theme
local Effects = {}
Effects.__index = Effects
local AudioCues = {
    Hover = { Id = "rbxassetid://85648618766955", Volume = 0.12 },
    Click = { Id = "rbxassetid://107136159030257", Volume = 0.24 },
    Confirm = { Id = "rbxassetid://134961823627800", Volume = 0.30 },
    Reward = { Id = "rbxassetid://104547582381900", Volume = 0.42 },
    Locked = { Id = "rbxassetid://113836048255506", Volume = 0.24 },
}
local NoticeCues = {
    Purchase = "Reward",
    Research = "Reward",
    World = "Reward",
    Expedition = "Confirm",
    Burst = "Confirm",
    Reward = "Reward",
    Achievement = "Reward",
    Collect = "Reward",
    Rebirth = "Reward",
    Error = "Locked",
}
local function playCue(name)
    local cue = AudioCues[name]
    if not cue then
        return
    end
    local sound = Instance.new("Sound")
    sound.Name = "Orbit" .. name
    sound.SoundId = cue.Id
    sound.Volume = cue.Volume
    sound.Parent = SoundService
    sound:Play()
    Debris:AddItem(sound, 4)
end
local function createMusic()
    local sound = Instance.new("Sound")
    sound.Name = "OrbitBackgroundMusic"
    sound.SoundId = "rbxassetid://128127190999486"
    sound.Looped = true
    sound.Volume = 0.22
    sound.Parent = SoundService
    sound:Play()
    return sound
end
function Effects:PlayCue(name)
    if name == "Hover" then
        local now = os.clock()
        if now &lt; self.NextHoverSound then
            return
        end
        self.NextHoverSound = now + 0.08
    end
    playCue(name)
end
local function circle(parent, name, color, size)
    local o = Instance.new("Frame")
    o.Name = name
    o.BorderSizePixel = 0
    o.BackgroundColor3 = color
    o.Size = UDim2.fromOffset(size, size)
    o.AnchorPoint = Vector2.new(0.5, 0.5)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = o
    o.Parent = parent
    return o
end
function Effects.new(view)
    local self = setmetatable({
        View = view,
        Spring = 1,
        Velocity = 0,
        Tilt = 0,
        Hover = false,
        Time = 0,
        Accumulator = 0,
        Display = 0,
        Particles = 0,
        Collectors = {},
        PassiveClock = 0,
        Clouds = {},
        CachedArt = nil,
        ButtonConnections = {},
        ButtonFeedback = {},
        NextHoverSound = 0,
    }, Effects)
    self.Music = createMusic()
    view.Animated = true
    view.Target.MouseEnter:Connect(function()
        self.Hover = true
        self:PlayCue("Hover")
    end)
    view.Target.MouseLeave:Connect(function()
        self.Hover = false
    end)
    local function animateButton(record, target, style, duration)
        if view.ReducedMotion then
            target = 1
        end
        if record.Tween then
            record.Tween:Cancel()
            record.Tween = nil
        end
        local tween = TweenService:Create(
            record.Scale,
            TweenInfo.new(duration, style, Enum.EasingDirection.Out),
            { Scale = target }
        )
        record.Tween = tween
        tween.Completed:Once(function()
            if record.Tween == tween then
                record.Tween = nil
            end
        end)
        tween:Play()
        return tween
    end
    local function hoverScale(record)
        return record.Hovered and not view.ReducedMotion and 1.025 or 1
    end
    for _, control in ipairs(view.Gui:GetDescendants()) do
        if control:IsA("GuiButton") and control ~= view.Target and control ~= view.Modal then
            local scale = control:FindFirstChildOfClass("UIScale")
            if not scale then
                scale = Instance.new("UIScale")
                scale.Name = "OrbitInteractionScale"
                scale.Parent = control
            end
            local record = { Control = control, Scale = scale, Hovered = false, Tween = nil }
            table.insert(self.ButtonFeedback, record)
            table.insert(
                self.ButtonConnections,
                control.MouseEnter:Connect(function()
                    record.Hovered = true
                    self:PlayCue("Hover")
                    animateButton(record, hoverScale(record), Enum.EasingStyle.Quad, 0.12)
                end)
            )
            table.insert(
                self.ButtonConnections,
                control.MouseLeave:Connect(function()
                    record.Hovered = false
                    animateButton(record, 1, Enum.EasingStyle.Quad, 0.12)
                end)
            )
            table.insert(
                self.ButtonConnections,
                control.Activated:Connect(function()
                    self:PlayCue("Click")
                    if view.ReducedMotion then
                        return
                    end
                    local press = animateButton(record, 0.95, Enum.EasingStyle.Quad, 0.06)
                    press.Completed:Once(function(playbackState)
                        if playbackState == Enum.PlaybackState.Completed and record.Control.Parent then
                            animateButton(record, hoverScale(record), Enum.EasingStyle.Back, 0.16)
                        end
                    end)
                end)
            )
        end
    end
    if view.Motion then
        table.insert(
            self.ButtonConnections,
            view.Motion.Activated:Connect(function()
                task.defer(function()
                    for _, record in ipairs(self.ButtonFeedback) do
                        if record.Tween then
                            record.Tween:Cancel()
                            record.Tween = nil
                        end
                        record.Scale.Scale = hoverScale(record)
                    end
                end)
            end)
        )
    end
    self.Connection = RunService.RenderStepped:Connect(function(dt)
        self.Accumulator += dt
        if self.Accumulator &gt;= 1 / 30 then
            local elapsed = self.Accumulator
            self.Accumulator = 0
            self:Step(math.min(elapsed, 0.05))
        end
    end)
    view.Gui.Destroying:Once(function()
        self:Destroy()
    end)
    return self
end
function Effects:Track(object, life)
    self.Particles += 1
    object.Destroying:Once(function()
        self.Particles = math.max(0, self.Particles - 1)
    end)
    Debris:AddItem(object, life + 0.2)
end
function Effects:Pop(message, color, x, y, big)
    if self.Particles &gt;= 70 then
        return
    end
    local v = self.View
    local o = Instance.new("TextLabel")
    o.Name = "RewardPop"
    o.BackgroundTransparency = 1
    o.Font = Enum.Font.GothamBold
    o.Text = message
    o.TextColor3 = color or T.Accent
    o.TextSize = big and 25 or 18
    o.Size = UDim2.fromOffset(180, 34)
    o.AnchorPoint = Vector2.new(0.5, 0.5)
    o.Position = UDim2.fromOffset(x or v.Target.Position.X.Offset, y or v.Target.Position.Y.Offset - 50)
    o.ZIndex = 10
    o.Parent = v.Particles
    self:Track(o, 0.8)
    TweenService:Create(
        o,
        TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Position = o.Position - UDim2.fromOffset(0, v.ReducedMotion and 8 or 48), TextTransparency = 1 }
    ):Play()
end
function Effects:Press()
    local v = self.View
    self:PlayCue("Click")
    self.Spring = v.ReducedMotion and 0.98 or 0.91
    self.Velocity = -0.4
    self.Tilt = math.random(-2, 2)
    if v.ReducedMotion or self.Particles &gt;= 60 then
        return
    end
    local d = v.Diameter or 250
    local p = v.Target.Position
    local ring = circle(v.Particles, "ClickRipple", T.Accent, d * 0.87)
    ring.BackgroundTransparency = 1
    ring.Position = p
    ring.ZIndex = 8
    local line = Instance.new("UIStroke")
    line.Color = T.Accent
    line.Transparency = 0.4
    line.Thickness = 2
    line.Parent = ring
    self:Track(ring, 0.45)
    TweenService:Create(
        ring,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.fromOffset(d * 1.25, d * 1.25) }
    ):Play()
    TweenService:Create(line, TweenInfo.new(0.4), { Transparency = 1 }):Play()
    for i = 1, 3 do
        local a = math.random() * math.pi * 2
        local radius = d * 0.49
        local x = p.X.Offset + math.cos(a) * radius
        local y = p.Y.Offset + math.sin(a) * radius
        local dot = circle(v.Particles, "ClickSpark", i == 1 and T.Accent or T.Text, math.random(3, 6))
        dot.Position = UDim2.fromOffset(x, y)
        self:Track(dot, 0.45)
        TweenService:Create(dot, TweenInfo.new(0.4), {
            Position = UDim2.fromOffset(x + math.cos(a) * 25, y + math.sin(a) * 25),
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(1, 1),
        }):Play()
    end
end
function Effects:Celebrate(strength)
    local v = self.View
    if v.ReducedMotion then
        return
    end
    for i = 1, math.min(strength or 14, 24) do
        if self.Particles &gt;= 70 then
            break
        end
        local a = i / (strength or 14) * math.pi * 2
        local r = (v.Diameter or 250) * 0.55
        local x, y = v.Target.Position.X.Offset, v.Target.Position.Y.Offset
        local dot = circle(v.Particles, "Celebration", i % 2 == 0 and T.Accent or T.AccentAlt, math.random(5, 9))
        dot.Position = UDim2.fromOffset(x, y)
        dot.Rotation = i * 20
        self:Track(dot, 1)
        TweenService:Create(dot, TweenInfo.new(0.9, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.fromOffset(x + math.cos(a) * r, y + math.sin(a) * r),
            BackgroundTransparency = 1,
            Rotation = dot.Rotation + 100,
        }):Play()
    end
end
function Effects:Update(previous, state)
    local v = self.View
    if previous and state.NoticeSerial ~= previous.NoticeSerial then
        local cue = NoticeCues[state.NoticeKind]
        if cue then
            self:PlayCue(cue)
        end
    end
    if not previous then
        self.Display = state.Currency
    end
    if previous and state.Currency &lt; previous.Currency then
        self.Display = state.Currency
    end
    if previous then
        for id, item in pairs(state.Upgrades) do
            if item.Owned &gt; ((previous.Upgrades[id] or {}).Owned or 0) then
                local row = v.Rows[id]
                local tile = row and row.Frame:FindFirstChild("IconTile")
                if tile then
                    local scale = tile:FindFirstChild("Pulse") or Instance.new("UIScale")
                    scale.Name = "Pulse"
                    scale.Parent = tile
                    scale.Scale = v.ReducedMotion and 0.98 or 0.8
                    TweenService
                        :Create(
                            scale,
                            TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                            { Scale = 1 }
                        )
                        :Play()
                end
            end
        end
        if state.CurrentZone ~= previous.CurrentZone or state.Prestiges &gt; previous.Prestiges then
            self:Celebrate(20)
        end
        if state.BurstEndsAt &gt; previous.BurstEndsAt then
            self:Celebrate(12)
        end
    end
    local count = 0
    for _, def in ipairs(require(Kit.UpgradeCatalog)) do
        if def.PassivePerSecond &gt; 0 then
            count += ((state.Upgrades[def.Id] or {}).Owned or 0)
        end
    end
    count = math.min(4, count)
    for i = #self.Collectors + 1, count do
        local o = Instance.new("Frame")
        o.Name = "ActiveCollector" .. i
        o.BackgroundTransparency = 1
        o.Size = UDim2.fromOffset(48, 48)
        o.AnchorPoint = Vector2.new(0.5, 0.5)
        o.Parent = v.CollectorLayer
        local scale = Instance.new("UIScale")
        scale.Scale = 0.62
        scale.Parent = o
        if T.CollectorStyle == "Cookie" then
            local cookie = circle(o, "Cookie", T.Accent, 32)
            cookie.Position = UDim2.fromOffset(24, 24)
            for _, p in ipairs({ { 17, 18 }, { 28, 28 }, { 17, 30 } }) do
                local chip = circle(o, "Chip", Color3.fromRGB(79, 47, 37), 5)
                chip.Position = UDim2.fromOffset(p[1], p[2])
            end
        else
            Art.Icon(o, "Drone", T.AccentAlt)
        end
        table.insert(self.Collectors, o)
    end
    for i = #self.Collectors, count + 1, -1 do
        self.Collectors[i]:Destroy()
        table.remove(self.Collectors, i)
    end
end
function Effects:Step(dt)
    local v = self.View
    if not v.Gui.Parent then
        self:Destroy()
        return
    end
    self.Time += dt
    local now = workspace:GetServerTimeNow()
    local s = v.State
    local reduced = v.ReducedMotion
    v:UpdatePaidBoostTimer(now)
    local desired = 1 + (self.Hover and not reduced and 0.025 or 0)
    self.Velocity += ((desired - self.Spring) * 240 - self.Velocity * 23) * dt
    self.Spring = math.clamp(self.Spring + self.Velocity * dt, 0.85, 1.08)
    v.Bounce.Scale = self.Spring
    self.Tilt *= math.exp(-8 * dt)
    if v.Art ~= self.CachedArt then
        self.CachedArt = v.Art
        self.Clouds = {}
        self.PulseBeams = v.Art:FindFirstChild("PulseBeams")
        self.PulseRing = v.Art:FindFirstChild("PulseRing")
        self.AccretionRing = v.Art:FindFirstChild("AccretionRing")
        self.InnerAccretion = v.Art:FindFirstChild("InnerAccretion")
        for _, o in ipairs(v.Art:GetChildren()) do
            if o.Name == "Cloud" then
                table.insert(self.Clouds, { Object = o, Position = o.Position })
            end
        end
    end
    v.Art.Rotation = reduced and 0 or math.sin(self.Time * 0.45) * 1.2 + self.Tilt
    v.Art.Position = UDim2.new(0.5, 0, 0.5, reduced and 0 or math.sin(self.Time * 0.8) * 3)
    if self.PulseBeams then
        self.PulseBeams.Rotation = reduced and 18 or self.Time * 22
        self.PulseBeams.JetGlow.BackgroundTransparency = reduced and 0.48 or 0.38 + math.sin(self.Time * 3) * 0.12
    end
    if self.PulseRing then
        self.PulseRing.Outline.Transparency = reduced and 0.4 or 0.45 + math.sin(self.Time * 3) * 0.2
    end
    if self.AccretionRing then
        self.AccretionRing.Rotation = reduced and -22 or -22 + math.sin(self.Time * 0.7) * 8
        self.AccretionRing.Outline.Transparency = reduced and 0.1 or 0.18 + math.sin(self.Time * 2) * 0.08
        self.InnerAccretion.Rotation = reduced and -22 or -22 - math.sin(self.Time * 0.7) * 6
    end
    local angle = reduced and 0.8 or self.Time * 0.6
    v.OrbitDot.Position = UDim2.fromScale(0.5 + math.cos(angle) * 0.49, 0.5 + math.sin(angle) * 0.49)
    for _, star in ipairs(v.Stars) do
        star.Object.BackgroundTransparency = reduced and star.Alpha
            or math.clamp(star.Alpha + math.sin(self.Time * 0.7 + star.Phase) * 0.15, 0.1, 0.92)
    end
    for i, cloud in ipairs(self.Clouds) do
        cloud.Object.Position = cloud.Position + UDim2.fromOffset(reduced and 0 or math.sin(self.Time * 0.3 + i) * 2, 0)
    end
    for i, o in ipairs(self.Collectors) do
        local a = (reduced and 0 or self.Time * 0.45) + i * math.pi / 2
        o.Position = UDim2.fromOffset(
            v.Target.Position.X.Offset + math.cos(a) * (v.Diameter or 250) * 0.64,
            v.Target.Position.Y.Offset + math.sin(a) * (v.Diameter or 250) * 0.35
        )
        o.Rotation = reduced and 0 or math.sin(a) * 9
    end
    if not s then
        return
    end
    local active = (s.BurstEndsAt or 0) &gt; now
    local rate = (s.BasePassiveRate or s.PassiveRate or 0) * (active and (s.BurstMultiplier or 3) or 1)
    local estimate =
        math.min(Config.MaximumCurrency, s.Currency + rate * math.clamp(now - (s.ServerTime or now), 0, 1.1))
    self.Display += (estimate - self.Display) * (1 - math.exp(-12 * dt))
    if math.abs(estimate - self.Display) &lt; 0.01 then
        self.Display = estimate
    end
    v.Currency.Text = Art.Number(self.Display)
    local fraction = active and math.clamp((s.BurstEndsAt - now) / (s.BurstDuration or 6), 0, 1)
        or (s.BurstCharge or 0) / (s.BurstNeeded or 20)
    v.BurstFill.Size = UDim2.fromScale(fraction, 1)
    v.BurstTitle.Text = (T.BurstName or "BOOST") .. (active and " / x" .. (s.BurstMultiplier or 3) or " CHARGE")
    v.BurstCount.Text = active and string.format("%.1fs", s.BurstEndsAt - now)
        or (s.BurstCharge or 0) .. " / " .. (s.BurstNeeded or 20)
    v.BurstNote.Text = active and "All clicks and producers earn x3!" or "20 clicks unlock a short x3 production boost"
    local halo = v.Art:FindFirstChild("Atmosphere")
    if halo and halo:FindFirstChild("Outline") then
        halo.Outline.Transparency = active and (reduced and 0.35 or 0.35 + math.sin(self.Time * 5) * 0.1) or 0.75
    end
    v.Comet.Visible = (s.EventEndsAt or 0) &gt; now
    if v.Comet.Visible then
        v.Comet.Position = UDim2.fromOffset(
            v.Compact and 80 or 388,
            (v.Landscape and 50 or 75) + (reduced and 0 or math.sin(self.Time * 2) * 7)
        )
        v.Comet.Rotation = reduced and 0 or math.sin(self.Time * 2) * 4
        v.CometTimer.Text = math.ceil(s.EventEndsAt - now) .. "s / TAP TO COLLECT"
    end
    self.PassiveClock += dt
    if rate &gt; 0 and self.PassiveClock &gt;= 1.2 and v.Scene.Visible then
        self.PassiveClock = 0
        local o = self.Collectors[1]
        if o then
            self:Pop(
                "+" .. Art.Number(rate) .. " / sec",
                T.AccentAlt,
                o.Position.X.Offset,
                o.Position.Y.Offset - 15,
                false
            )
        end
    end
    v:UpdateExpeditions(now)
end
function Effects:Destroy()
    if self.Music then
        self.Music:Stop()
        self.Music:Destroy()
        self.Music = nil
    end
    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end
    for _, connection in ipairs(self.ButtonConnections) do
        connection:Disconnect()
    end
    for _, record in ipairs(self.ButtonFeedback) do
        if record.Tween then
            record.Tween:Cancel()
            record.Tween = nil
        end
    end
end
return Effects
end
local default = create()
function default.new(view, config)
    local implementation = create(config or view.Config)
    return implementation.new(view)
end
return default
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXd74a92044c514ed195dd22387d5fbb50">
        <Properties>
          <string name="Name">StarClientController</string>
          <ProtectedString name="Source">-- Disposable view controls; persistent input/remote listeners live in ClickerClient.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("ClickerKit")
local UI=require(Shared.Interface)
local Themes=require(Shared.SystemThemeFactory)
local Stars=require(Shared.StarSystemCatalog)
local Rules=require(Shared.MonetizationRules)
local U=require(Shared.StarUtil)
local Effects=require(script.Parent.Effects)
local TweenService=game:GetService("TweenService")
local C={};C.__index=C
function C.new(parent,hooks)
    local self=setmetatable({Parent=parent,Hooks=hooks,ViewConnections={},Prices={},ToastSerial=0,LastClick=0,AutoTapAccumulator=0,
        Viewport=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280,800)},C)
    self:_build("Sun");return self
end
function C:_connect(signal,fn)local c=signal:Connect(fn);table.insert(self.ViewConnections,c);return c end
function C:_send(kind,id,quantity)
    if self.Destroyed or not self.State then return false end
    self.Hooks.SendAction(kind,id,quantity);return true
end
function C:Toast(message)
    if self.Destroyed then return end
    self.ToastSerial+=1;local serial=self.ToastSerial
    self.View.ToastText.Text=message;self.View.Toast.Visible=true
    task.delay(3,function()if not self.Destroyed and self.ToastSerial==serial then self.View.Toast.Visible=false end end)
end
function C:CancelWorldScroll()
    local tween=self.ScrollTween;self.ScrollTween=nil;self.ScrollGoal=nil
    if tween then tween:Cancel()end
end
function C:UpdateWorldScrollButtons()
    if self.Destroyed or not self.View then return end
    local v=self.View;local list=v.WorldList;local vertical=list.ScrollingDirection==Enum.ScrollingDirection.Y
    local p=self.ScrollGoal or list.CanvasPosition
    local offset=vertical and p.Y or p.X
    local maximum=math.max(0,vertical and (list.AbsoluteCanvasSize.Y-list.AbsoluteWindowSize.Y)or(list.AbsoluteCanvasSize.X-list.AbsoluteWindowSize.X))
    v.WorldBack.Active=offset&gt;1;v.WorldNext.Active=offset&lt;maximum-1
    v.WorldBack.TextTransparency=v.WorldBack.Active and 0 or .65;v.WorldNext.TextTransparency=v.WorldNext.Active and 0 or .65
end
function C:ScrollWorlds(direction)
    local v=self.View;local list=v.WorldList;local vertical=list.ScrollingDirection==Enum.ScrollingDirection.Y
    local current=self.ScrollGoal or list.CanvasPosition;local zones=v.Config.Zones
    local first=v.Zones[zones[1].Id].Button;local second=v.Zones[zones[2].Id].Button
    local stride=math.abs(vertical and (second.AbsolutePosition.Y-first.AbsolutePosition.Y)or(second.AbsolutePosition.X-first.AbsolutePosition.X))
    if stride&lt;1 then stride=vertical and 80 or 230 end
    local target=UI.WorldScrollOffset(vertical and current.Y or current.X,vertical and list.AbsoluteWindowSize.Y or list.AbsoluteWindowSize.X,
        vertical and list.AbsoluteCanvasSize.Y or list.AbsoluteCanvasSize.X,stride,direction)
    local goal=vertical and Vector2.new(0,target)or Vector2.new(target,0)
    self:CancelWorldScroll()
    if v.ReducedMotion then list.CanvasPosition=goal;self:UpdateWorldScrollButtons();return end
    self.ScrollGoal=goal
    local tween=TweenService:Create(list,TweenInfo.new(.22,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CanvasPosition=goal})
    self.ScrollTween=tween
    tween.Completed:Once(function()if self.ScrollTween==tween then self.ScrollTween=nil;self.ScrollGoal=nil;self:UpdateWorldScrollButtons()end end)
    tween:Play();self:UpdateWorldScrollButtons()
end
function C:OverWorldList(input)
    local v=self.View
    if v.Page~="Play" or not v.Worlds.Visible or v.Modal.Visible or v.DiscoveryConfirmation.Visible then return false end
    local p,s=v.WorldList.AbsolutePosition,v.WorldList.AbsoluteSize
    return input.Position.X&gt;=p.X and input.Position.X&lt;=p.X+s.X and input.Position.Y&gt;=p.Y and input.Position.Y&lt;=p.Y+s.Y
end
function C:Click()
    local v=self.View
    if not self.State or self.PendingTransition or self.Checkout or self.State.TransactionBusy or v.Modal.Visible or v.DiscoveryConfirmation.Visible
        or v.Page~="Play" or(v.Compact and v.PlayPage~="Collect")then return end
    local now=os.clock();if now-self.LastClick&lt;v.Config.ClickCooldown then return end
    self.LastClick=now;self.Effects:Press();self:_send("Click")
end
function C:Travel(id)
    if not self.State or self.PendingTransition or self.Checkout or self.State.CanTravel==false or self.State.TransactionBusy then return false end
    local row=self.View.StarCards[id];local item=row and row.Item
    if not item then return false end
    if item.Status=="Discover"then self.View:OpenDiscovery(id);return true end
    if item.Status~="Travel"then return false end
    self.PendingTransition=true;return self:_send("TravelSystem",id)
end
function C:ConfirmDiscovery()
    local id=self.View.DiscoveryTarget;local row=id and self.View.StarCards[id]
    if not row or not row.Item or row.Item.Status~="Discover" or self.PendingTransition or self.Checkout or self.State.CanTravel==false then return false end
    self.View.DiscoveryConfirmation.Visible=false;self.PendingTransition=true
    return self:_send("DiscoverSystem",id)
end
function C:_build(id)
    local reduced=self.View and self.View.ReducedMotion or false
    self.ToastSerial+=1;self:CancelWorldScroll()
    for _,c in ipairs(self.ViewConnections)do c:Disconnect()end
    self.ViewConnections={}
    if self.Effects then self.Effects:Destroy()end
    if self.View then self.View.Gui:Destroy()end
    local config=Themes.Get(id)
    self.View=UI.ForConfig(config).Build(self.Parent)
    local v=self.View;v.ReducedMotion=reduced;v.Motion.Text=reduced and "Motion: OFF" or "Motion: ON"
    v.ShopPrices=self.Prices
    self.Effects=(self.Hooks.EffectsFactory or Effects.new)(v,config)
    self.AutoTapAccumulator=0;self.LastClick=0
    self:_connect(v.Target.Activated,function()self:Click()end)
    for page,b in pairs(v.Nav)do self:_connect(b.Activated,function()v:SetPage(page)end)end
    for page,b in pairs(v.MobileTabs)do self:_connect(b.Activated,function()v:SetPlayPage(page)end)end
    for q,b in pairs(v.QuantityButtons)do self:_connect(b.Activated,function()v.Quantity=q;if self.State then v:Render(self.State)end end)end
    for key,row in pairs(v.ShopOffers)do self:_connect(row.Button.Activated,function()if self.Hooks.PromptOffer then self.Hooks.PromptOffer(key,self)end end)end
    for key,row in pairs(v.CosmeticRows)do self:_connect(row.Button.Activated,function()
        if self.State and self.State.OwnedPasses[row.Cosmetic.PassKey]then self:_send("EquipCosmetic",key)else self:Toast("Unlock this cosmetic in the Shop first.")end
    end)end
    self:_connect(v.AutoBuy.Activated,function()if self.State and self.State.AutoBuyUnlocked then self:_send("AutoBuy",not self.State.AutoBuyEnabled)end end)
    for id,row in pairs(v.Rows)do self:_connect(row.Buy.Activated,function()self:_send("Buy",id,v.Quantity)end)end
    for id,row in pairs(v.Zones)do self:_connect(row.Button.Activated,function()self:_send("Zone",id)end)end
    self:_connect(v.WorldBack.Activated,function()self:ScrollWorlds(-1)end)
    self:_connect(v.WorldNext.Activated,function()self:ScrollWorlds(1)end)
    self:_connect(v.WorldList:GetPropertyChangedSignal("CanvasPosition"),function()self:UpdateWorldScrollButtons()end)
    for _,property in ipairs({"AbsoluteCanvasSize","AbsoluteWindowSize","ScrollingDirection"})do
        self:_connect(v.WorldList:GetPropertyChangedSignal(property),function()self:CancelWorldScroll();self:UpdateWorldScrollButtons()end)
    end
    for name,b in pairs(v.JournalButtons)do self:_connect(b.Activated,function()v:SetFilter(name)end)end
    for _,cards in pairs(v.Cards)do for _,row in pairs(cards)do self:_connect(row.Button.Activated,function()
        local s=self.State;if not s then return end
        if row.Kind=="Expedition"then
            if not row.Button.Active then return end
            if s.Expedition then self:_send("ClaimExpedition")else self:_send("Expedition",row.Id)end
        elseif row.Kind=="Achievement" or row.Kind=="Daily"then
            if row.Item and row.Item.Ready then self:_send(row.Kind,row.Id)else self:Toast("Complete this goal before collecting its reward.")end
        else self:_send(row.Kind,row.Id)end
    end)end end
    local function ascend()
        if self.State and self.State.CanPrestige then v.Modal.Visible=true else self:Toast("Earn more Energy to Ascend.")end
    end
    self:_connect(v.Rebirth.Activated,ascend);self:_connect(v.AscendButton.Activated,ascend)
    self:_connect(v.Cancel.Activated,function()v.Modal.Visible=false end)
    self:_connect(v.Confirm.Activated,function()if self.State and self.State.CanPrestige then self:_send("Rebirth")end;v.Modal.Visible=false end)
    self:_connect(v.Motion.Activated,function()v.ReducedMotion=not v.ReducedMotion;v.Motion.Text=v.ReducedMotion and "Motion: OFF"or"Motion: ON"end)
    self:_connect(v.Comet.Activated,function()if self.State then self:_send("Collect",self.State.EventNonce)end end)
    self:_connect(v.StarMapButton.Activated,function()v:SetPage("StarMap")end)
    self:_connect(v.StarMapBack.Activated,function()v:SetPage("Play");v:SetPlayPage("Worlds")end)
    for id,row in pairs(v.StarCards)do self:_connect(row.Button.Activated,function()self:Travel(id)end)end
    self:_connect(v.DiscoveryCancel.Activated,function()v.DiscoveryConfirmation.Visible=false;v.DiscoveryTarget=nil end)
    self:_connect(v.DiscoveryConfirm.Activated,function()self:ConfirmDiscovery()end)
    for section,tabs in pairs(v.StellarTabs)do
        self:_connect(tabs.Standard.Activated,function()v:SetStellarMode(section,false)end)
        self:_connect(tabs.Interstellar.Activated,function()v:SetStellarMode(section,true)end)
        for target,rows in pairs(v.StellarCards[section])do for track,row in pairs(rows)do self:_connect(row.Button.Activated,function()
            if row.Item and row.Item.CanBuy then self:_send(section=="Research"and"StellarResearch"or"StellarAscension",target,track)end
        end)end end
    end
    v:Layout(self.Viewport);self:UpdateWorldScrollButtons()
end
function C:ApplySnapshot(snapshot)
    if self.Destroyed or type(snapshot)~="table"then return false end
    if snapshot.Kind=="ClickFeedback"then
        local s=self.State
        if s and snapshot.ActiveSystemId==s.ActiveSystemId and snapshot.DiscoveryGeneration==s.DiscoveryGeneration
            and (snapshot.AccountRevision==nil or snapshot.AccountRevision&gt;=(s.AccountRevision or 0)) and U.Finite(snapshot.Gain) and snapshot.Gain&gt;0 then
            self.Effects:Pop("+"..UI.Number(snapshot.Gain),nil,self.View.Target.Position.X.Offset,self.View.Target.Position.Y.Offset-45,true)
        end
        return true
    end
    if not Stars.Get(snapshot.ActiveSystemId) or not U.Finite(snapshot.DiscoveryGeneration)then return false end
    local previous=self.State
    if previous then
        if snapshot.DiscoveryGeneration&lt;previous.DiscoveryGeneration or(snapshot.AccountRevision or 0)&lt;(previous.AccountRevision or 0)then return false end
        if snapshot.AccountRevision==previous.AccountRevision and (snapshot.ServerTime or 0)&lt;(previous.ServerTime or 0)then return false end
    end
    local changed=not previous or snapshot.ActiveSystemId~=previous.ActiveSystemId or snapshot.DiscoveryGeneration~=previous.DiscoveryGeneration
    self.State=snapshot
    if changed then self:_build(snapshot.ActiveSystemId);previous=nil end
    if not snapshot.TransactionBusy then self.PendingTransition=false end
    self.View:Render(snapshot);self.Effects:Update(previous,snapshot)
    if previous and snapshot.NoticeSerial~=previous.NoticeSerial and snapshot.Notice and snapshot.Notice~=""then self:Toast(snapshot.Notice)end
    if not previous and(snapshot.OfflineEarned or 0)&gt;0 then self:Toast("Welcome back! +"..UI.Number(snapshot.OfflineEarned).." offline Energy.")end
    return true
end
function C:SetViewport(size)self.Viewport=size;if not self.Destroyed then self.View:Layout(size);self:UpdateWorldScrollButtons()end end
function C:SetPrice(key,price)self.Prices[key]=price;if self.State then self.View:Render(self.State)end end
function C:SetCheckout(enabled)self.Checkout=enabled==true;self:_send("CheckoutBusy",self.Checkout)end
function C:AutoTapStep(dt)
    if self.Destroyed then return end
    local s,v=self.State,self.View
    local clicks,left=Rules.AdvanceAutoTap(s and s.OwnedPasses,self.AutoTapAccumulator,dt);self.AutoTapAccumulator=left
    if s and not v.Modal.Visible and not v.DiscoveryConfirmation.Visible and v.Page=="Play"and(not v.Compact or v.PlayPage=="Collect")then
        for _=1,clicks do self.Effects:Press()end
    end
end
function C:Destroy()
    if self.Destroyed then return end
    self.Destroyed=true;self.ToastSerial+=1;self:CancelWorldScroll()
    for _,c in ipairs(self.ViewConnections)do c:Disconnect()end
    self.ViewConnections={};if self.Effects then self.Effects:Destroy()end
    if self.View then self.View.Gui:Destroy()end
end
return C
</ProtectedString>
        </Properties>
      </Item>
