  <Item class="ServerScriptService" referent="RBX9b9afbfc2b514678ac5a0bcc72dd941e">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX3eb59c1362384084bd273ecafa43a5d1">
